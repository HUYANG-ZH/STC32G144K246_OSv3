  105          void soft_iic_send_ack (soft_iic_info_struct *soft_iic_obj, uint8 ack)
  106          {
  107   1          zf_assert(soft_iic_obj != NULL);
  108   1          gpio_low(soft_iic_obj->scl_pin);                                            // SCL 低电平
  109   1      
  110   1          if(ack)
  111   1          {
  112   2              gpio_high(soft_iic_obj->sda_pin);                                       // SDA 拉高
  113   2          }
  114   1          else
  115   1          {
  116   2              gpio_low(soft_iic_obj->sda_pin);                                        // SDA 拉低
  117   2          }
  118   1      
  119   1          soft_iic_delay(soft_iic_obj->delay);
  120   1          gpio_high(soft_iic_obj->scl_pin);                                           // SCL 拉高
  121   1          soft_iic_delay(soft_iic_obj->delay);
  122   1          gpio_low(soft_iic_obj->scl_pin);                                            // SCL 拉低
  123   1          gpio_high(soft_iic_obj->sda_pin);                                           // SDA 拉高
  124   1      }
