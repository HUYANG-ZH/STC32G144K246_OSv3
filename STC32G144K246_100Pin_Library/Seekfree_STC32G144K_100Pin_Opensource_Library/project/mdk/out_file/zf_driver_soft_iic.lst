             -------------
  707          uint8 soft_iic_sccb_read_register (soft_iic_info_struct *soft_iic_obj, const uint8 register_name)
  708          {
  709   1          uint8 temp = 0;
  710   1              zf_assert(soft_iic_obj != NULL);
  711   1          soft_iic_start(soft_iic_obj);
  712   1          soft_iic_send_data(soft_iic_obj, soft_iic_obj->addr << 1);
  713   1          soft_iic_send_data(soft_iic_obj, register_name);
  714   1          soft_iic_stop(soft_iic_obj);
  715   1      
  716   1          soft_iic_start(soft_iic_obj);
  717   1          soft_iic_send_data(soft_iic_obj, soft_iic_obj->addr << 1 | 0x01);
  718   1          temp = soft_iic_read_data(soft_iic_obj, 1);
  719   1          soft_iic_stop(soft_iic_obj);
  720   1          return temp;
  721   1      }
