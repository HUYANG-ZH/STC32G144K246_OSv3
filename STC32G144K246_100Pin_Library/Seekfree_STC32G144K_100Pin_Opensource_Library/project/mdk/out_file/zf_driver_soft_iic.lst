  147   1      
  148   1          if(gpio_get_level((gpio_pin_enum)soft_iic_obj->sda_pin))
  149   1          {
  150   2              temp = 1;
  151   2          }
  152   1          gpio_low(soft_iic_obj->scl_pin);                                            // SCL 低电平
  153   1      #if SOFT_IIC_SDA_IO_SWITCH
                   gpio_set_dir(soft_iic_obj->sda_pin, GPO, GPO_OPEN_DTAIN);
               #endif
  156   1          soft_iic_delay(soft_iic_obj->delay);
  157   1      
