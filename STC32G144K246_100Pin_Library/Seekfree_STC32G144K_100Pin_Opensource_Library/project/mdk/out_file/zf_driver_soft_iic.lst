   65          void soft_iic_start (soft_iic_info_struct *soft_iic_obj)
   66          {
   67   1          zf_assert(soft_iic_obj != NULL);
   68   1          gpio_high(soft_iic_obj->scl_pin);                                           // SCL 高电平
   69   1          gpio_high(soft_iic_obj->sda_pin);                                           // SDA 高电平
   70   1      
   71   1          soft_iic_delay(soft_iic_obj->delay);
   72   1          gpio_low(soft_iic_obj->sda_pin);                                            // SDA 先拉低
   73   1          soft_iic_delay(soft_iic_obj->delay);
   74   1          gpio_low(soft_iic_obj->scl_pin);                                            // SCL 再拉低
   75   1      }
