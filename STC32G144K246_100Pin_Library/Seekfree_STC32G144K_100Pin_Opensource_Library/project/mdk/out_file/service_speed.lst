   69   1          speed_data.odo_left_m = tfpu_add(speed_data.odo_left_m,
   70   1                  tfpu_mul(tfpu_int2float(encoder_delta.left), SERVICE_SPEED_DISTANCE_PER_PULSE_M));
   71   1          speed_data.odo_right_m = tfpu_add(speed_data.odo_right_m,
   72   1                  tfpu_mul(tfpu_int2float(encoder_delta.right), SERVICE_SPEED_DISTANCE_PER_PULSE_M));
   73   1          speed_data.odo_total_m = tfpu_mul(
   74   1                  tfpu_add(speed_data.odo_left_m, speed_data.odo_right_m), 0.5f);
   75   1      }
