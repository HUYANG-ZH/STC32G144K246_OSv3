    7          
    8          #define SERVICE_SPEED_PI                     (3.1415926f)
    9          #define SERVICE_SPEED_ENCODER_PULSE_PER_REV (1024.0f)
   10          #define SERVICE_SPEED_ENCODER_TO_WHEEL_RATIO (4.4f)
   11          #define SERVICE_SPEED_WHEEL_DIAMETER_M       (0.0252f)
   12          #define SERVICE_SPEED_SAMPLE_PERIOD_MS       (1U)
   13          #define SERVICE_SPEED_SAMPLE_PERIOD_SECOND   (0.001f)
   14          
   15          #define SERVICE_SPEED_DISTANCE_PER_PULSE_M \
   16              ((SERVICE_SPEED_PI * SERVICE_SPEED_WHEEL_DIAMETER_M) / \
   17              (SERVICE_SPEED_ENCODER_PULSE_PER_REV * SERVICE_SPEED_ENCODER_TO_WHEEL_RATIO))
   18          
   19          #define SERVICE_SPEED_MPS_PER_PULSE \
   20              (SERVICE_SPEED_DISTANCE_PER_PULSE_M / SERVICE_SPEED_SAMPLE_PERIOD_SECOND)
   21          
   22          #define SERVICE_SPEED_LPF_ALPHA              (0.2f)
   23          
   24          static volatile service_speed_data_t speed_data = {0.0f, 0.0f};
   25          static shared_lpf_t speed_lpf_left;
   26          static shared_lpf_t speed_lpf_right;
   27          
   28          void service_speed_init(void)
   29          {
   30   1          bsp_encoder_init();
   31   1          speed_data.left_mps = 0.0f;
   32   1          speed_data.right_mps = 0.0f;
   33   1          shared_lpf_init(&speed_lpf_left, SERVICE_SPEED_LPF_ALPHA, 0.0f);
   34   1          shared_lpf_init(&speed_lpf_right, SERVICE_SPEED_LPF_ALPHA, 0.0f);
   35   1          pit_ms_init(TIM3_PIT, SERVICE_SPEED_SAMPLE_PERIOD_MS, service_speed_update);
   36   1      }
   37          
   38          void service_speed_debug(void)
   39          {
   40   1          service_speed_data_t testdata;
   41   1          service_delay_ms(1000U);
   42   1          service_speed_get(&testdata);
   43   1          printf("[speed:] %f,%f\r\n",testdata.left_mps,testdata.right_mps);
   44   1      }
   45          
   46          void service_speed_update(void)
   47          {
   48   1          bsp_encoder_count_t encoder_delta;
   49   1      
   50   1          bsp_encoder_get_delta(&encoder_delta);
   51   1          speed_data.left_mps = shared_lpf_update(&speed_lpf_left,
   52   1                  tfpu_mul(tfpu_int2float(encoder_delta.left), SERVICE_SPEED_MPS_PER_PULSE));
   53   1          speed_data.right_mps = shared_lpf_update(&speed_lpf_right,
   54   1                  tfpu_mul(tfpu_int2float(encoder_delta.right), SERVICE_SPEED_MPS_PER_PULSE));
   55   1      }
