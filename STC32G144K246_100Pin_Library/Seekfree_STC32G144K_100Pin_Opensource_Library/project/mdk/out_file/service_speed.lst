   58          void service_speed_update(void)
   59          {
   60   1          bsp_encoder_count_t encoder_delta;
   61   1      
   62   1          bsp_encoder_get_delta(&encoder_delta);
   63   1          speed_data.left_mps = shared_lpf_update(&speed_lpf_left,
   64   1                  tfpu_mul(tfpu_int2float(encoder_delta.left), SERVICE_SPEED_MPS_PER_PULSE));
   65   1          speed_data.right_mps = shared_lpf_update(&speed_lpf_right,
   66   1                  tfpu_mul(tfpu_int2float(encoder_delta.right), SERVICE_SPEED_MPS_PER_PULSE));
   67   1      
   68   1          /* 编码器积分里程: 用本周期原始脉冲数累加左右轮行进距离(米), 不受滤波�
