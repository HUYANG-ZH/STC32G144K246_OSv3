  116          static float app_attitude_pitch_lpf_update(float input)
  117          {
  118   1          float delta;
  119   1          float output;
  120   1      
  121   1          /* 回绕感知一阶低通: 0/360 接缝处(恰为水平姿态)避免线性混叠,
C251 COMPILER V5.60.0,  app_attitude                                                       10/08/26  00:23:47  PAGE 3   

  122   1             359→0 按 -1° 处理而非 -359°, 防止平路振动虚假触发 (30,330) */
  123   1          output = attitude_pitch_lpf.output;
  124   1          delta = tfpu_sub(input, output);
  125   1          if(delta > 180.0f)
  126   1          {
  127   2              delta = tfpu_sub(delta, 360.0f);
  128   2          }
  129   1          else if(delta < -180.0f)
  130   1          {
  131   2              delta = tfpu_add(delta, 360.0f);
  132   2          }
  133   1          output = tfpu_add(output, tfpu_mul(attitude_pitch_lpf.alpha, delta));
  134   1          if(output >= 360.0f)
  135   1          {
  136   2              output = tfpu_sub(output, 360.0f);
  137   2          }
  138   1          else if(output < 0.0f)
  139   1          {
  140   2              output = tfpu_add(output, 360.0f);
  141   2          }
  142   1          attitude_pitch_lpf.output = output;
  143   1          return output;
  144   1      }
