   21          static float app_attitude_atan2(float y, float x)
   22          {
   23   1          float value;
   24   1      
   25   1          if(x > 0.0f)
   26   1          {
   27   2              value = tfpu_atan(tfpu_div(y, x));
   28   2          }
   29   1          else if(x < 0.0f)
   30   1          {
   31   2              value = tfpu_atan(tfpu_div(y, x));
   32   2              value = (y >= 0.0f) ? tfpu_add(value, APP_ATTITUDE_PI) :
   33   2                      tfpu_sub(value, APP_ATTITUDE_PI);
   34   2          }
   35   1          else if(y > 0.0f)
   36   1          {
   37   2              value = APP_ATTITUDE_HALF_PI;
   38   2          }
   39   1          else if(y < 0.0f)
   40   1          {
   41   2              value = tfpu_sub(0.0f, APP_ATTITUDE_HALF_PI);
   42   2          }
   43   1          else
   44   1          {
   45   2              value = 0.0f;
   46   2          }
   47   1      
   48   1          return value;
   49   1      }
