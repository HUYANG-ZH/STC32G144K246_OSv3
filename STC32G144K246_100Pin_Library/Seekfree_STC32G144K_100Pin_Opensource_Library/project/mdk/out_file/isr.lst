  309          {
  310   1          static vuint8 dwon_count = 0;
  311   1          uint8 uart_dat;
  312   1      
  313   1          if (DMA_UR1R_STA & 0x01) // 接收完成
  314   1          {
C251 COMPILER V5.60.0,  isr                                                                15/08/26  16:10:17  PAGE 6   

  315   2              uart_dat = uart_rx_take_byte(UART_1);
  316   2      
  317   2              // 程序自动下载
  318   2              if (uart_dat == 0x7F)
  319   2              {
  320   3                  if (dwon_count++ > 50)
  321   3                  {
  322   4                      IAP_CONTR = 0x60;
  323   4                  }
  324   3              }
  325   2              else
  326   2              {
  327   3                  dwon_count = 0;
  328   3              }
