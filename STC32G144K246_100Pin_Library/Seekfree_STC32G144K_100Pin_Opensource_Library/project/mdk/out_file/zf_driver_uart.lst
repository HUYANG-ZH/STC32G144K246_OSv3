  253          uint16 uart_write_buffer_async(uart_index_enum uart_n, const uint8 *buff, uint16 len)
  254          {
  255   1          uart_tx_dma_state_t xdata *state;
  256   1          uint16 accepted = 0U;
  257   1          uint16 start_head;
  258   1          uint16 next_head;
  259   1          uint16 tail_snapshot;
  260   1          uint16 candidate_head;
