  213          // Called with global interrupts masked.  It only arms one contiguous DMA
  214          // segment and never waits for completion.
  215          static void uart_tx_start_next_locked(uart_index_enum uart_n)
  216          {
  217   1          uart_tx_dma_state_t xdata *state;
  218   1          uint16 available;
  219   1          uint16 contiguous;
  220   1      
  221   1          state = &uart_tx_dma_state[uart_n];
