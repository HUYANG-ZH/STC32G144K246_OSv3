  229   2              state->in_flight = 0U;
  230   2              DMA_URXT_CR(uart_n) = 0x00U;
  231   2              return;
  232   2          }
  233   1      
  234   1          available = (uint16)((state->head - state->tail) & UART_TX_QUEUE_MASK);
  235   1          contiguous = (state->head > state->tail) ? available : (uint16)(UART_TX_QUEUE_SIZE - state->tail);
  236   1          if(0U == contiguous)
  237   1          {
  238   2              return;
  239   2          }
  240   1      
  241   1          DMA_URXT_CR(uart_n) = 0x00U;
  242   1          DMA_URXT_STA(uart_n) = 0x00U;
  243   1          DMA_URXT_AMT(uart_n) = (uint8)((contiguous - 1U) & 0xFFU);
  244   1          DMA_URXT_AMTH(uart_n) = (uint8)((contiguous - 1U) >> 8);
  245   1          DMA_URXT_TXAH(uart_n) = (uint8)((uint16)&state->buffer[state->tail] >> 8);
  246   1          DMA_URXT_TXAL(uart_n) = (uint8)((uint16)&state->buffer[state->tail]);
  247   1          DMA_URXT_CFG(uart_n) = 0x80U;       // DMA completion IRQ, lowest DMA priority
  248   1          state->in_flight = contiguous;
  249   1          state->active = 1U;
  250   1          DMA_URXT_CR(uart_n) = 0xC1U;         // enable master TX DMA and clear FIFO
  251   1      }
