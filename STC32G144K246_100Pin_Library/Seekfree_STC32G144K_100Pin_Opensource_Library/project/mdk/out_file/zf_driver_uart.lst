  263   1          if((0U == uart_index_is_valid(uart_n)) || (NULL == buff) || (0U == len))
  264   1          {
  265   2              return 0U;
  266   2          }
  267   1      
  268   1          ea_backup = EA;
  269   1          EA = 0;
  270   1          state = &uart_tx_dma_state[uart_n];
  271   1          start_head = state->head;
  272   1          next_head = start_head;
  273   1          tail_snapshot = state->tail;
  274   1          EA = ea_backup;
  275   1      
  276   1          /*
  277   1           * DMA consumes only bytes below head.  Copy first and publish head only
  278   1           * after the complete fragment is in xdata, so control IRQs stay enabled
  279   1           * for the potentially long memory copy.
  280   1           */
