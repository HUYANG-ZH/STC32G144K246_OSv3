             -------------
  564          void uart_tim_init(uart_index_enum uart_n, uint32 baud, uart_pin_enum tx_pin, uart_pin_enum rx_pin, timer
             -_index_enum tim_n)
  565          {
  566   1          uint16 brt;
  567   1      
  568   1              // 如果程序在输出了断言信息 并且提示出错位置在这里
  569   1          // 就去查看你在什么地方调用这个函数 检查你的传入参数
  570   1          // 这里是检查是否有重复使用定时器
  571   1              // TIM2已经给串口用作波特率发生器了。不能再初始化为其他的。
  572   1              zf_assert(timer_funciton_check(tim_n, TIMER_FUNCTION_UART));
  573   1              
