             -------------
  538          // 函数简介     FIFO 初始化 挂载对应缓冲区
  539          // 参数说明     *fifo               FIFO 对象指针
  540          // 参数说明     type                FIFO 数据位数
  541          // 参数说明     *buffer_addr        要挂载的缓冲区
  542          // 参数说明     siz                缓冲区大小
  543          // 返回参数     fifo_state_enum     操作状态
  544          // 使用示例     fifo_init(&user_fifo, user_buffer, 64);
  545          // 备注信息
  546          //-------------------------------------------------------------------------------------------------------
             -------------
  547          fifo_state_enum fifo_init (fifo_struct *fifo, fifo_data_type_enum type, void *buffer_addr, uint32 siz)
  548          {
  549   1          zf_assert(NULL != fifo);
  550   1          do
  551   1          {
  552   2              fifo->buffer    = buffer_addr;
  553   2              fifo->execution = FIFO_IDLE;
  554   2              fifo->type      = type;
  555   2              fifo->head      = 0;
C251 COMPILER V5.60.0,  zf_common_fifo                                                     20/07/26  19:25:30  PAGE 11  

  556   2              fifo->end       = 0;
  557   2              fifo->siz      = siz;
  558   2              fifo->max       = siz;
  559   2          }while(0);
  560   1          return FIFO_SUCCESS;
  561   1      }


