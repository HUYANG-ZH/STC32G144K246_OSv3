  120          //-------------------------------------------------------------------------------------------------------
             -------------
  121          // 函数简介     ADC初始化
  122          // 参数说明     ch            ch(可选择范围由zf_adc.h内adc_channel_enum枚举值确定)
  123          // 参数说明     resolution       resolution(可选择范围由zf_adc.h内adc_resolution_enum枚举值
             -确定)
  124          // 返回参数     void
  125          // 使用示例     adc_init(ADC1_CH0_P10, ADC_12BIT);//初始化P10引脚为ADC功能，12位分辨率
  126          //-------------------------------------------------------------------------------------------------------
             -------------
  127          void adc_init(adc_channel_enum ch, adc_resolution_enum resolution)
  128          {
  129   1          gpio_init(ch & 0xFF, GPI, 1, GPI_ANALOG);
  130   1      
  131   1          if((ch >> 12) == 0)
  132   1          {
  133   2      
  134   2              ADC_CONTR &= (0xF0);              // 清除ADC_CHS[3:0] ： ADC 模拟通道选择位
  135   2              ADC_CONTR |= (ch >> 8) & 0xF;
  136   2              
  137   2              ADCCFG |= ADC_SYSclk_DIV_32;          // ADC时钟频率SYSclk/16&0x0F;
  138   2              ADCCFG |= 1 << 5;             // 转换结果右对齐。 ADC_RES 保存结果的高 2 位， ADC_RES
             -L 保存结果的低 8 位。
  139   2              
  140   2              adc_resolution[0] = resolution;         // 记录ADC精度 将在采集时使用
  141   2              
  142   2              ADC_CONTR |= 1 << 7;            // 打开 ADC 电源
  143   2          }
  144   1          else if((ch >> 12) == 1)
  145   1          {
  146   2      
  147   2              ADC2_CONTR &= (0xF0);             // 清除ADC_CHS[3:0] ： ADC 模拟通道选择位
  148   2              ADC2_CONTR |= (ch >> 8) & 0xF;
  149   2              
  150   2              ADC2CFG |= ADC_SYSclk_DIV_32;           // ADC时钟频率SYSclk/16&0x0F;
  151   2              ADC2CFG |= 1 << 5;                  // 转换结果右对齐。 ADC_RES 保存结果的高 2 位， 
             -ADC_RESL 保存结果的低 8 位。
  152   2              
  153   2              adc_resolution[1] = resolution;         // 记录ADC精度 将在采集时使用
  154   2      
  155   2              ADC2_CONTR |= 1 << 7;           // 打开 ADC 电源
  156   2          }
  157   1          system_delay_ms(1);
  158   1      }


