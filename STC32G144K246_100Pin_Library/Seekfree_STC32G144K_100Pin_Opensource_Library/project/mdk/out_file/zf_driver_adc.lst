C251 COMPILER V5.60.0,  zf_driver_adc                                                      22/05/26  22:36:12  PAGE 2   

   49          // 使用示例     adc_mean_filter(ADC1_CH0_P10, 5);  //采集A0端口返回8位分辨率的AD值，采�
             -��五次取平均值
   50          //-------------------------------------------------------------------------------------------------------
             -------------
   51          uint16 adc_mean_filter_convert (adc_channel_enum ch, const uint8 count)
   52          {
   53   1          uint8 i;
   54   1          uint32 sum;
   55   1      
   56   1        zf_assert(count);//断言次数不能为0
   57   1        
   58   1          sum = 0;
   59   1          for(i=0; i<count; i++)
   60   1          {
   61   2              sum += adc_convert(ch);
   62   2          }
   63   1      
   64   1          sum = sum/count;
   65   1          return sum;
   66   1      }
   67          
   68          //-------------------------------------------------------------------------------------------------------
             -------------
   69          //  @brief      ADC转换一次
   70          //  @param      adcn            选择ADC通道
   71          //  @param      resolution      分辨率
   72          //  @return     void
   73          //  Sample usage:               adc_convert(ADC1_CH0_P10);
   74          //-------------------------------------------------------------------------------------------------------
             -------------
   75          uint16 adc_convert(adc_channel_enum ch)
   76          {
   77   1          uint16 adc_value = 0;
   78   1          
   79   1          if((ch >> 12 )== 0)
   80   1          {
   81   2              ADC_CONTR &= ~0x20;           // 清完成标志
   82   2              ADC_CONTR &= (0xF0);          // 清除ADC_CHS[3:0] ： ADC 模拟通道选择位
   83   2              ADC_CONTR |= (ch >> 8) & 0xF;   
   84   2                  
   85   2              ADC_CONTR |= 0x40;            // 启动 AD 转换
   86   2                  
   87   2              while (!(ADC_CONTR & 0x20));        // 查询 ADC 完成标志
   88   2                  
   89   2              adc_value = ADC_RES << 8;       // 存储 ADC 的 12 位结果的高 4 位
   90   2              adc_value |= ADC_RESL;          // 存储 ADC 的 12 位结果的低 8 位
   91   2              
   92   2              ADC_RES = 0;
   93   2              ADC_RESL = 0;
   94   2              
   95   2              adc_value >>= adc_resolution[0];  // 取多少位
   96   2          }
   97   1          else if((ch >> 12) == 1)
   98   1          {
   99   2              ADC2_CONTR &= ~0x20;            // 清完成标志
  100   2              ADC2_CONTR &= (0xF0);         // 清除ADC_CHS[3:0] ： ADC 模拟通道选择位
  101   2              ADC2_CONTR |= (ch >> 8) & 0xF;  
  102   2                  
  103   2              ADC2_CONTR |= 0x40;           // 启动 AD 转换
  104   2                  
  105   2              while (!(ADC2_CONTR & 0x20));       // 查询 ADC 完成标志
  106   2                  
  107   2              adc_value = ADC2_RES << 8;      // 存储 ADC 的 12 位结果的高 4 位
  108   2              adc_value |= ADC2_RESL;         // 存储 ADC 的 12 位结果的低 8 位
  109   2              
  110   2              ADC2_RES = 0;
C251 COMPILER V5.60.0,  zf_driver_adc                                                      22/05/26  22:36:12  PAGE 3   

  111   2              ADC2_RESL = 0;
  112   2              
  113   2              adc_value >>= adc_resolution[1];  //取多少位
  114   2          
  115   2          }
  116   1          
  117   1          return adc_value;
  118   1      }
