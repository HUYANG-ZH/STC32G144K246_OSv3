               static void bsp_tof_fail(iic_status_enum status)
               {
                   tof_last_error = (uint8)status;
                   tof_distance_mm = BSP_TOF_INVALID_DISTANCE_MM;
                   tof_ready = 0U;
                   tof_sample_requested = 0U;
                   tof_submit_busy_pending = 0U;
