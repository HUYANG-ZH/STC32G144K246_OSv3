                   {
                       return 0U;
                   }
                   status = iic_async_get_status(DL1B_IIC);
                   if(IIC_SUCCESS != status)
                   {
                       bsp_tof_fail(status);
                       return 0U;
                   }
                   return 1U;
               }
               
