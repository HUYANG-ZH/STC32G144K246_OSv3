  115          void app_motion_preprocess_control_step(void)
  116          {
  117   1          app_inductor_preprocess_data_t inductor_data;
  118   1          app_motion_preprocess_data_t output;
  119   1      
  120   1          app_inductor_preprocess_get_data(&inductor_data);
  121   1      
  122   1          output.y_error = app_motion_preprocess_diff_ratio(inductor_data.normalized[0], inductor_data.normaliz
             -ed[3]);
  123   1          /* x 轴(前进方向)差比抗噪公式:
  124   1             x_error = (CH2-CH3)/(CH2+CH3+x_den_b) * max(CH2,CH3)/(max(CH2,CH3)+x_gate_s0)
  125   1             直道弱信号时: 分母偏置防小分母放大 + 强度门控把增益压到接近 0 -> 噪声
             -不进控制链
  126   1             弯道强信号时: 门控增益 -> 1, 偏置相对大分母可忽略 -> 差比保持敏感 */
  127   1          {
  128   2              float x_strength;
  129   2              float x_gate;
  130   2              float x_raw;
  131   2      
  132   2              x_strength = (inductor_data.normalized[1] > inductor_data.normalized[2]) ?
  133   2                      inductor_data.normalized[1] : inductor_data.normalized[2];
  134   2              x_gate = tfpu_div(x_strength,
  135   2                      tfpu_add(x_strength, motion_pre_x_gate_s0));
  136   2              x_raw = tfpu_div(tfpu_sub(inductor_data.normalized[1], inductor_data.normalized[2]),
  137   2                      tfpu_add(tfpu_add(inductor_data.normalized[1], inductor_data.normalized[2]),
  138   2                      motion_pre_x_den_bias));
  139   2              output.x_error = tfpu_mul(x_raw, x_gate);
  140   2          }
  141   1      
  142   1          output.line_error = tfpu_add(tfpu_mul(output.y_error, motion_pre_y_weight),
  143   1                  tfpu_mul(output.x_error, motion_pre_x_weight));
  144   1          output.linear_mps = app_motion_preprocess_config.linear_mps;
  145   1          output.target_yaw_rate_rps = tfpu_mul(app_motion_preprocess_config.yaw_rate_gain, output.line_error);
  146   1      
  147   1          motion_preprocess_data.x_error = output.x_error;
  148   1          motion_preprocess_data.y_error = output.y_error;
  149   1          motion_preprocess_data.line_error = output.line_error;
  150   1          motion_preprocess_data.linear_mps = output.linear_mps;
  151   1          motion_preprocess_data.target_yaw_rate_rps = output.target_yaw_rate_rps;
  152   1      }


