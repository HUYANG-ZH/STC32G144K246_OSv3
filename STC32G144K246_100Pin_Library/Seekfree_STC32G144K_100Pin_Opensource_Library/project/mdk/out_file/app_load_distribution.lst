   46   1          datas->LTC = tfpu_div(tfpu_mul(datas->ay, APP_LOAD_DISTRIBUTION_CAR_HEIGHT_M), ltc_denominator);
   47   1          datas->LTC = app_load_distribution_limit_ltc(datas->LTC);
   48   1      
