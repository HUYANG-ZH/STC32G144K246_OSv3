000000                   10     ?C?ULDIV?:
000000 75D89F            11             MOV     DPUOP,#09FH
000003 AA                12             ERET
                         13     PUBLIC  ?C?ULIDIV?
000004                   14     ?C?ULIDIV?:
000004 6D00              15             XRL     WR0,WR0
000006 75D89F            16             MOV     DPUOP,#09FH
000009 AA                17             ERET
                         18     PUBLIC  ?C?SLDIV?
00000A                   19     ?C?SLDIV?:
00000A 75D8A0            20             MOV     DPUOP,#0A0H
00000D AA                21             ERET
                         22     PUBLIC  ?C?SIDIV?
00000E                   23     ?C?SIDIV?:
00000E 75D8A4            24             MOV     DPUOP,#0A4H
000011 AA                25             ERET
                         26     END
