  370          // 返回参数     uint8           操作结果 0-成功 1-失败
  371          // 使用示例     dl1a_set_measurement_timing_budget(measurement_timing_budget_us);
  372          // 备注信息     这是一次测量允许的时间
  373          //              即在测距序列的子步骤之间分配时间预算
  374          //              更长的时间预算允许更精确的测量
  375          //              增加一个N倍的预算可以减少一个sqrt(N)倍的范围测量标准偏差
  376          //              默认为33毫秒 最小值为20 ms
  377          //-------------------------------------------------------------------------------------------------------
             -------------
  378          static uint8 dl1a_set_measurement_timing_budget (uint32 budget_us)
  379          {
  380   1          uint8 return_state = 0;
  381   1          uint8 data_buffer[3];
  382   1          uint16 dat = 0;
  383   1          
  384   1          uint32 final_range_timeout_us = 0;
  385   1          uint16 final_range_timeout_mclks = 0;
  386   1          
  387   1          dl1a_sequence_enables_step_struct enables;
  388   1          dl1a_sequence_timeout_step_struct timeouts;
  389   1          
  390   1          do
  391   1          {
  392   2              uint32 used_budget_us = DL1A_SET_START_OVERHEAD + DL1A_END_OVERHEAD;
  393   2              
  394   2              if(DL1A_MIN_TIMING_BUDGET > budget_us)
  395   2              {
  396   3                  return_state = 1;
  397   3                  break;
  398   3              }
  399   2              
  400   2              dl1a_get_sequence_step_enables(&enables);
  401   2              dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  402   2              
  403   2              if(enables.tcc)
  404   2              {
  405   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  406   3              }
  407   2              
  408   2              if(enables.dss)
  409   2              {
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     29/07/26  19:15:08  PAGE 8   

  410   3                  used_budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  411   3              }
  412   2              else if(enables.msrc)
  413   2              {
  414   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  415   3              }
  416   2              
  417   2              if(enables.pre_range)
  418   2              {
  419   3                  used_budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  420   3              }
  421   2              
  422   2              if(enables.final_range)
  423   2              {
  424   3                  // 请注意 最终范围超时由计时预算和序列中所有其他超时的总和决定
  425   3                  // 如果没有空间用于最终范围超时 则将设置错误
  426   3                  // 否则 剩余时间将应用于最终范围
  427   3                  used_budget_us += DL1A_FINALlRANGE_OVERHEAD;
  428   3                  
  429   3                  if(used_budget_us > budget_us)
  430   3                  {
  431   4                      // 请求的超时太大
  432   4                      return_state = 1;
  433   4                      break;
  434   4                  }
  435   3                  
  436   3                  // 对于最终超时范围 必须添加预量程范围超时
  437   3                  // 为此 最终超时和预量程超时必须以宏周期 MClks 表示
  438   3                  // 因为它们具有不同的 VCSEL 周期
  439   3                  final_range_timeout_us = budget_us - used_budget_us;
  440   3                  final_range_timeout_mclks =
  441   3                      (uint16)dl1a_timeout_microseconds_to_mclks(final_range_timeout_us,
  442   3                          (uint8)timeouts.final_range_vcsel_period_pclks);
  443   3                          
  444   3                  if(enables.pre_range)
  445   3                  {
  446   4                      final_range_timeout_mclks += timeouts.pre_range_mclks;
  447   4                  }
  448   3                  
  449   3                  dat = dl1a_encode_timeout(final_range_timeout_mclks);
  450   3                  data_buffer[0] = DL1A_FINAL_RANGE_CONFIG_TIMEOUT_MACROP_HI;
  451   3                  data_buffer[1] = ((dat >> 8) & 0xFF);
  452   3                  data_buffer[2] = (dat & 0xFF);
  453   3                  dl1a_write_array(data_buffer, 3);
  454   3              }
  455   2          }
  456   1          while(0);
  457   1          
  458   1          return return_state;
  459   1      }
