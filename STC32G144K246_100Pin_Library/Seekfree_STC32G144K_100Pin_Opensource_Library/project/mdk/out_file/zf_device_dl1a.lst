C251 COMPILER V5.60.0,  zf_device_dl1a                                                     29/07/26  19:15:08  PAGE 10  

  536          // 备注信息     在开始单次射程测量后也调用此函数
  537          //-------------------------------------------------------------------------------------------------------
             -------------
  538          void dl1a_get_distance (void)
  539          {
  540   1          if(dl1a_init_flag)
  541   1          {
  542   2              uint8 reg_databuffer[3];
  543   2              
  544   2              dl1a_read_registers(DL1A_RESULT_INTERRUPT_STATUS, reg_databuffer, 1);
  545   2              
  546   2              if(0 != (reg_databuffer[0] & 0x07))
  547   2              {
  548   3                  // 假设线性度校正增益为默认值 1000 且未启用分数范围
  549   3                  dl1a_read_registers(DL1A_RESULT_RANGE_STATUS + 10, reg_databuffer, 2);
  550   3                  dl1a_distance_mm = ((uint16)reg_databuffer[0] << 8);
  551   3                  dl1a_distance_mm |= reg_databuffer[1];
  552   3                  
  553   3                  dl1a_write_register(DL1A_SYSTEM_INTERRUPT_CLEAR, 0x01);
  554   3                  dl1a_finsh_flag = 1;
  555   3              }
  556   2              
  557   2              if(reg_databuffer[0] & 0x10)
  558   2              {
  559   3                  dl1a_read_registers(DL1A_RESULT_RANGE_STATUS + 10, reg_databuffer, 2);
  560   3                  dl1a_write_register(DL1A_SYSTEM_INTERRUPT_CLEAR, 0x01);
  561   3              }
  562   2          }
  563   1      }
