  532          //-------------------------------------------------------------------------------------------------------
             -------------
  533          // 函数简介     返回以毫米为单位的范围读数
  534          // 参数说明     void
  535          // 返回参数     void
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/08/26  20:17:58  PAGE 10  

  536          // 使用示例     dl1a_get_distance();
  537          // 备注信息     在开始单次射程测量后也调用此函数
  538          //-------------------------------------------------------------------------------------------------------
             -------------
  539          uint8 dl1a_parse_range_status(uint8 raw_status)
  540          {
  541   1          uint8 device_range_status;
  542   1      
  543   1          /* RESULT_RANGE_STATUS[6:3] is the VL53L0X device status field. */
  544   1          device_range_status = (uint8)((raw_status & 0x78U) >> 3);
  545   1      
  546   1          /* Map the device status to standard RangeStatus values. Limit-check
  547   1             results such as sigma fail are not recomputed by this lightweight path. */
  548   1          if((0U == device_range_status) ||
  549   1                  (5U == device_range_status) ||
  550   1                  (7U == device_range_status) ||
  551   1                  (device_range_status >= 12U))
  552   1          {
  553   2              return DL1A_RANGE_STATUS_NO_UPDATE;
  554   2          }
  555   1          if(device_range_status <= 3U)
  556   1          {
  557   2              return 5U;       /* Hardware fail */
  558   2          }
  559   1          if((6U == device_range_status) || (9U == device_range_status))
  560   1          {
  561   2              return 4U;       /* Phase fail */
  562   2          }
  563   1          if((8U == device_range_status) || (10U == device_range_status))
  564   1          {
  565   2              return 3U;       /* Min range fail */
  566   2          }
  567   1          if(4U == device_range_status)
  568   1          {
  569   2              return 2U;       /* Signal fail */
  570   2          }
  571   1      
  572   1          return 0U;           /* Range valid (device status 11) */
  573   1      }
  574          
  575          void dl1a_get_distance (void)
  576          {
  577   1          if(dl1a_init_flag)
  578   1          {
  579   2              uint8 reg_databuffer[12];
  580   2              uint8 interrupt_status;
  581   2              
  582   2              dl1a_read_registers(DL1A_RESULT_INTERRUPT_STATUS, reg_databuffer, 1);
  583   2      
  584   2              interrupt_status = reg_databuffer[0];
  585   2              if(0U != (interrupt_status & 0x07U))
  586   2              {
  587   3                  /* Read RangeStatus (0x14) and final range (0x1E/0x1F) together. */
  588   3                  dl1a_read_registers(DL1A_RESULT_RANGE_STATUS, reg_databuffer, 12);
  589   3                  dl1a_range_status = dl1a_parse_range_status(reg_databuffer[0]);
  590   3      
  591   3                  // 假设线性度校正增益为默认值 1000 且未启用分数范围
  592   3                  dl1a_distance_mm = ((uint16)reg_databuffer[10] << 8);
  593   3                  dl1a_distance_mm |= reg_databuffer[11];
  594   3                  if(dl1a_distance_mm > 8191U)
  595   3                  {
  596   4                      dl1a_distance_mm = 8192U;
  597   4                      dl1a_range_status = DL1A_RANGE_STATUS_NO_UPDATE;
  598   4                  }
  599   3      
  600   3                  dl1a_write_register(DL1A_SYSTEM_INTERRUPT_CLEAR, 0x01);
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/08/26  20:17:58  PAGE 11  

  601   3                  dl1a_finsh_flag = 1;
  602   3              }
  603   2          }
  604   1      }
