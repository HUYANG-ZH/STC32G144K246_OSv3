  370          // 参数说明     budget_us       设定的测量允许的时间
  371          // 返回参数     uint8           操作结果 0-成功 1-失败
  372          // 使用示例     dl1a_set_measurement_timing_budget(measurement_timing_budget_us);
  373          // 备注信息     这是一次测量允许的时间
  374          //              即在测距序列的子步骤之间分配时间预算
  375          //              更长的时间预算允许更精确的测量
  376          //              增加一个N倍的预算可以减少一个sqrt(N)倍的范围测量标准偏差
  377          //              默认为33毫秒 最小值为20 ms
  378          //-------------------------------------------------------------------------------------------------------
             -------------
  379          static uint8 dl1a_set_measurement_timing_budget (uint32 budget_us)
  380          {
  381   1          uint8 return_state = 0;
  382   1          uint8 data_buffer[3];
  383   1          uint16 dat = 0;
  384   1          
  385   1          uint32 final_range_timeout_us = 0;
  386   1          uint16 final_range_timeout_mclks = 0;
  387   1          
  388   1          dl1a_sequence_enables_step_struct enables;
  389   1          dl1a_sequence_timeout_step_struct timeouts;
  390   1          
  391   1          do
  392   1          {
  393   2              uint32 used_budget_us = DL1A_SET_START_OVERHEAD + DL1A_END_OVERHEAD;
  394   2              
  395   2              if(DL1A_MIN_TIMING_BUDGET > budget_us)
  396   2              {
  397   3                  return_state = 1;
  398   3                  break;
  399   3              }
  400   2              
  401   2              dl1a_get_sequence_step_enables(&enables);
  402   2              dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  403   2              
  404   2              if(enables.tcc)
  405   2              {
  406   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  407   3              }
  408   2              
  409   2              if(enables.dss)
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/08/26  20:17:58  PAGE 8   

  410   2              {
  411   3                  used_budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  412   3              }
  413   2              else if(enables.msrc)
  414   2              {
  415   3                  used_budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  416   3              }
  417   2              
  418   2              if(enables.pre_range)
  419   2              {
  420   3                  used_budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  421   3              }
  422   2              
  423   2              if(enables.final_range)
  424   2              {
  425   3                  // 请注意 最终范围超时由计时预算和序列中所有其他超时的总和决定
  426   3                  // 如果没有空间用于最终范围超时 则将设置错误
  427   3                  // 否则 剩余时间将应用于最终范围
  428   3                  used_budget_us += DL1A_FINALlRANGE_OVERHEAD;
  429   3                  
  430   3                  if(used_budget_us > budget_us)
  431   3                  {
  432   4                      // 请求的超时太大
  433   4                      return_state = 1;
  434   4                      break;
  435   4                  }
  436   3                  
  437   3                  // 对于最终超时范围 必须添加预量程范围超时
  438   3                  // 为此 最终超时和预量程超时必须以宏周期 MClks 表示
  439   3                  // 因为它们具有不同的 VCSEL 周期
  440   3                  final_range_timeout_us = budget_us - used_budget_us;
  441   3                  final_range_timeout_mclks =
  442   3                      (uint16)dl1a_timeout_microseconds_to_mclks(final_range_timeout_us,
  443   3                          (uint8)timeouts.final_range_vcsel_period_pclks);
  444   3                          
  445   3                  if(enables.pre_range)
  446   3                  {
  447   4                      final_range_timeout_mclks += timeouts.pre_range_mclks;
  448   4                  }
  449   3                  
  450   3                  dat = dl1a_encode_timeout(final_range_timeout_mclks);
  451   3                  data_buffer[0] = DL1A_FINAL_RANGE_CONFIG_TIMEOUT_MACROP_HI;
  452   3                  data_buffer[1] = ((dat >> 8) & 0xFF);
  453   3                  data_buffer[2] = (dat & 0xFF);
  454   3                  dl1a_write_array(data_buffer, 3);
  455   3              }
  456   2          }
  457   1          while(0);
  458   1          
  459   1          return return_state;
  460   1      }
  461          
  462          //-------------------------------------------------------------------------------------------------------
             -------------
  463          // 函数简介     获取测量定时预算 (以微秒为单位)
  464          // 参数说明     void
  465          // 返回参数     uint32          已设定的测量允许的时间
  466          // 使用示例     dl1a_get_measurement_timing_budget();
  467          // 备注信息
  468          //-------------------------------------------------------------------------------------------------------
             -------------
  469          static uint32 dl1a_get_measurement_timing_budget (void)
  470          {
  471   1          dl1a_sequence_enables_step_struct enables;
  472   1          dl1a_sequence_timeout_step_struct timeouts;
  473   1          
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     11/08/26  20:17:58  PAGE 9   

  474   1          // 开始和结束开销时间始终存在
  475   1          uint32 budget_us = DL1A_GET_START_OVERHEAD + DL1A_END_OVERHEAD;
  476   1          
  477   1          dl1a_get_sequence_step_enables(&enables);
  478   1          dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  479   1          
  480   1          if(enables.tcc)
  481   1          {
  482   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  483   2          }
  484   1          
  485   1          if(enables.dss)
  486   1          {
  487   2              budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  488   2          }
  489   1          else if(enables.msrc)
  490   1          {
  491   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  492   2          }
  493   1          
  494   1          if(enables.pre_range)
  495   1          {
  496   2              budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  497   2          }
  498   1          
  499   1          if(enables.final_range)
  500   1          {
  501   2              budget_us += (timeouts.final_range_us + DL1A_FINALlRANGE_OVERHEAD);
  502   2          }
  503   1          
  504   1          return budget_us;
  505   1      }
