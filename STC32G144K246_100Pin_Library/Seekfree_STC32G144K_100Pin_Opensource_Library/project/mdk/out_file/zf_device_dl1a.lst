  507          //-------------------------------------------------------------------------------------------------------
             -------------
  508          // 函数简介     设置返回信号速率限制 该值单位为 MCPS (百万次每秒)
  509          // 参数说明     limit_mcps      设置的最小速率
  510          // 返回参数     void
  511          // 使用示例     dl1a_set_signal_rate_limit(0.25);
  512          // 备注信息     这个速率表示从目标反射并被设备检测到的信号的振幅
  513          //              设置此限制可以确定传感器报告有效读数所需的最小测量值
  514          //              设置一个较低的限制可以增加传感器的测量范围
  515          //              但似乎也增加了 <由于来自目标以外的物体的不需要的反射导致> 得�
             -��不准确读数的可能性
  516          //              默认为 0.25 MCPS 可预设范围为 0 - 511.99
  517          //-------------------------------------------------------------------------------------------------------
             -------------
  518          static void dl1a_set_signal_rate_limit (float limit_mcps)
  519          {
  520   1          uint8 data_buffer[3];
  521   1          uint16 limit_mcps_16bit = (uint16)(limit_mcps * (1 << 7));
  522   1          
  523   1          zf_assert(0 <= limit_mcps || 511.99 >= limit_mcps);
  524   1          
  525   1          data_buffer[0] = DL1A_FINAL_RANGE_CONFIG_MIN_COUNT_RATE_RTN_LIMIT;
  526   1          data_buffer[1] = ((limit_mcps_16bit >> 8) & 0xFF);
  527   1          data_buffer[2] = (limit_mcps_16bit & 0xFF);
  528   1          
  529   1          dl1a_write_array(data_buffer, 3);
  530   1      }
