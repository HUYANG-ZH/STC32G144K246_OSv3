  466          // 备注信息
  467          //-------------------------------------------------------------------------------------------------------
             -------------
  468          static uint32 dl1a_get_measurement_timing_budget (void)
  469          {
  470   1          dl1a_sequence_enables_step_struct enables;
  471   1          dl1a_sequence_timeout_step_struct timeouts;
  472   1          
  473   1          // 开始和结束开销时间始终存在
C251 COMPILER V5.60.0,  zf_device_dl1a                                                     29/07/26  19:15:08  PAGE 9   

  474   1          uint32 budget_us = DL1A_GET_START_OVERHEAD + DL1A_END_OVERHEAD;
  475   1          
  476   1          dl1a_get_sequence_step_enables(&enables);
  477   1          dl1a_get_sequence_step_timeouts(&enables, &timeouts);
  478   1          
  479   1          if(enables.tcc)
  480   1          {
  481   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_TCC_OVERHEAD);
  482   2          }
  483   1          
  484   1          if(enables.dss)
  485   1          {
  486   2              budget_us += 2 * (timeouts.msrc_dss_tcc_us + DL1A_DSS_OVERHEAD);
  487   2          }
  488   1          else if(enables.msrc)
  489   1          {
  490   2              budget_us += (timeouts.msrc_dss_tcc_us + DL1A_MSRC_OVERHEAD);
  491   2          }
  492   1          
  493   1          if(enables.pre_range)
  494   1          {
  495   2              budget_us += (timeouts.pre_range_us + DL1A_PRERANGE_OVERHEAD);
  496   2          }
  497   1          
  498   1          if(enables.final_range)
  499   1          {
  500   2              budget_us += (timeouts.final_range_us + DL1A_FINALlRANGE_OVERHEAD);
  501   2          }
  502   1          
  503   1          return budget_us;
  504   1      }
