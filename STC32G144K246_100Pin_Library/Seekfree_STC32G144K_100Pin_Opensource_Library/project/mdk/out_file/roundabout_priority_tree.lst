stmt  level    source

    1          #include "sys_tfpu.h"
    2          #include "roundabout_priority_tree.h"
    3          
    4          #define ROUNDABOUT_SCORE_THRESHOLD    (31860.0f)
    5          
    6          /*
    7           * 单帧环岛评分模型，输入顺序保持为 (y1, x1, x2, y2)。
    8           * car3 已彻底弃用 M 通道电感：原 M 项(y2 交叉项与 M 二次项)整体移除，
    9           * 其余各项系数与阈值保持不变。
   10           *
   11           * 函数名保留原接口名称，确保 app_element 中现有的姿态、确认次数、
   12           * 死区和状态机等附加判断逻辑完全不变。
   13           */
   14          uint8 roundabout_priority_tree_predict(float y1, float x1, float x2, float y2)
   15          {
   16   1          float score;
   17   1          float inner;
   18   1          float term;
   19   1      
   20   1          score = tfpu_mul(192.2f, y1);
   21   1          term = tfpu_mul(110.3f, x2);
   22   1          score = tfpu_add(score, term);
   23   1      
   24   1          /* y2 * (243.9 - 0.803*x1)  (原含 -0.985*M 项已随 M 弃用移除) */
   25   1          inner = 243.9f;
   26   1          term = tfpu_mul(0.803f, x1);
   27   1          inner = tfpu_sub(inner, term);
   28   1          term = tfpu_mul(y2, inner);
   29   1          score = tfpu_add(score, term);
   30   1      
   31   1          return (score >= ROUNDABOUT_SCORE_THRESHOLD) ? 1U : 0U;
   32   1      }


