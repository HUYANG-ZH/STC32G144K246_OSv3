  462          uint8 roundabout_priority_tree_predict(float y1, float x1, float x2, float y2, float m)
  463          {
  464   1          int16 node = 0;
  465   1      
  466   1          while (kFeature[node] >= 0)
  467   1          {
  468   2              float value;
  469   2      
  470   2              switch (kFeature[node])
  471   2              {
  472   3                  case 0: value = y1; break;
  473   3                  case 1: value = x1; break;
  474   3                  case 2: value = x2; break;
  475   3                  case 3: value = y2; break;
  476   3                  default: value = m; break;
  477   3              }
  478   2      
  479   2              node = (value <= kThreshold[node]) ? kLeft[node] : kRight[node];
  480   2          }
  481   1      
  482   1          return (0U != kResult[node]) ? 1U : 0U;
  483   1      }


