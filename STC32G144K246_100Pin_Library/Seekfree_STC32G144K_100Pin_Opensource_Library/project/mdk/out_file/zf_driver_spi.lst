  692          // 函数简介     SPI_DMA 接口初始化
  693          // 参数说明     spi_n           SPI 模块号 参照 zf_driver_spi.h 内 spi_index_enum 枚举体定�
             -��
  694          // 参数说明     mode            SPI_DMA 模式 参照 zf_driver_spi.h 内 spi_mode_enum 枚举体定�
             -��
  695          // 参数说明     baud            设置 SPI_DMA 的波特率 不超过系统时钟的一半 部分速�
             -��会被适配成相近的速率
  696          // 参数说明     sck_pin         选择 SCK 引脚 参照 zf_driver_spi.h 内 spi_pin_enum 枚举体�
             -�义
  697          // 参数说明     mosi_pin        选择 MOSI 引脚 参照 zf_driver_spi.h 内 spi_pin_enum 枚举体�
             -��义
  698          // 参数说明     miso_pin        选择 MISO 引脚 参照 zf_driver_spi.h 内 spi_pin_enum 枚举体�
             -��义
  699          // 参数说明     cs_pin          选择 CS 引脚 参照 zf_driver_gpio.h 内 gpio_pin_enum 枚举体�
             -��义
  700          // 返回参数     void
  701          // 使用示例     spi_init(SPI_1, 0, 1*1000*1000, SPI1_SCK_A5, SPI1_MOSI_A7, SPI1_MISO_A6, A4);  //硬�
             -��SPI初始化  模式0 波特率为1Mhz
  702          //-------------------------------------------------------------------------------------------------------
             -------------
  703          void spi_dma_init(spi_index_enum spi_n, spi_mode_enum mode, uint32 baud, spi_pin_enum sck_pin, spi_pin_en
             -um mosi_pin, spi_pin_enum miso_pin, gpio_pin_enum cs_pin)
  704          {
  705   1          // 使用SPI_DMA CLK频率就必须要两分频，所以这里填写时钟
  706   1          uint32 spi_psc = 0;
  707   1          
  708   1          if((sck_pin & 0xFF00) != (mosi_pin & 0xFF00))
  709   1          {
  710   2              zf_assert(0);
  711   2              // SPI只能使用同一组引脚，不允许混用引脚
  712   2          }
  713   1          
  714   1          gpio_init(sck_pin  & 0xFF, GPO, 1, GPO_PUSH_PULL);
  715   1          gpio_init(mosi_pin & 0xFF, GPO, 1, GPO_PUSH_PULL);
  716   1          
  717   1          if(miso_pin != SPI_NULL_PIN)
  718   1          {
  719   2              gpio_init(miso_pin & 0xFF, GPI, 1, GPI_PULL_UP);
  720   2          }
  721   1          
  722   1          if(cs_pin != SPI_NULL_PIN)
  723   1          {
  724   2              gpio_init(cs_pin & 0xFF, GPO, 0, GPO_PUSH_PULL);
  725   2          }
  726   1      
  727   1              // 波特率大于等于10M就需要设置GPIO电平转换速度
  728   1              if(baud >= (10*1000*1000U))
  729   1              {
  730   2                      gpio_set_level_speed(sck_pin  & 0xFF, GPIO_SPEED_FAST);
  731   2                      gpio_set_level_speed(mosi_pin  & 0xFF, GPIO_SPEED_FAST);
  732   2                      if(miso_pin != SPI_NULL_PIN)
  733   2                      {
  734   3                              gpio_set_level_speed(miso_pin & 0xFF, GPIO_SPEED_FAST);
  735   3                      }
  736   2                      if(cs_pin != SPI_NULL_PIN)
  737   2                      {
  738   3                              gpio_set_level_speed(cs_pin & 0xFF, GPIO_SPEED_FAST);
  739   3                      }
  740   2              }
  741   1          
  742   1          switch(spi_n)
  743   1          {
  744   2              case SPI_1:
  745   2              {
C251 COMPILER V5.60.0,  zf_driver_spi                                                      24/07/26  17:47:33  PAGE 14  

  746   3                  P_SW1 &= ~(0x03 << 2); // 清除SPI_1引脚选择位
  747   3                  switch((sck_pin >> 8) & 0x03) 
  748   3                  {
  749   4                      case 0: P_SW1 |= 0x00 << 2; break;
  750   4                      case 1: P_SW1 |= 0x01 << 2; break;
  751   4                      case 2: P_SW1 |= 0x02 << 2; break;
  752   4                      case 3: P_SW1 |= 0x03 << 2; break;
  753   4                  }
  754   3      
  755   3                  SPCTL = 0; // 初始化SPI_1控制寄存器
  756   3                  SPCTL |= (1 << 7) | (1 << 4); // 忽略SS引脚 + 主机模式
  757   3                  
  758   3                  SPCTL |= 0x03; // 时钟/2
  759   3      
  760   3                  // 配置SPI_1极性相位
  761   3                  switch(mode) 
  762   3                  {
  763   4                      case SPI_MODE1: SPCTL |= 0x01 << 2; break;
  764   4                      case SPI_MODE2: SPCTL |= 0x02 << 2; break;
  765   4                      case SPI_MODE3: SPCTL |= 0x03 << 2; break;
  766   4                      default: break; // MODE0默认
  767   4                  }
  768   3                  SPCTL |= 1 << 6; // 使能SPI_1
  769   3                  break;
  770   3              }
  771   2              
