  428          void spi_dma_read(spi_index_enum spi_n, const uint8 *read_buffer, uint32 len)
  429          {
  430   1          DMA_SPIX_AMT(spi_n)  = (uint8)((len - 1) & 0xFF);               //设置传输总字节数(低8位)：n
             -+1
  431   1          DMA_SPIX_AMTH(spi_n) = (uint8)(((len - 1) & 0xFF00) >> 8);          //设置传输总字节数(高8位)：n+1
  432   1          DMA_SPIX_RXAH(spi_n) = (uint8)((uint16)&read_buffer[0] >> 8);               // SPI接收数据存储地址
  433   1          DMA_SPIX_RXAL(spi_n) = (uint8)((uint16)&read_buffer[0]);
  434   1      
  435   1          DMA_SPIX_CFG(spi_n)  = 1 << 5;                                  // 读取数据
  436   1          DMA_SPIX_CR(spi_n)   = 0xC1;                                    // 使能SPI_DMA 设置为主机模�
             -� 清空FIFO
  437   1          while(!(DMA_SPIX_STA(spi_n) & 0x01));
  438   1          DMA_SPIX_STA(spi_n)  = 0;                                       // 清空标志位
  439   1      }
