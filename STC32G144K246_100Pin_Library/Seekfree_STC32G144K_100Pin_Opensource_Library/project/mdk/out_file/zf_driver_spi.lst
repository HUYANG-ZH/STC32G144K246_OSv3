  337   3                  write_buffer += tmp_len;                                                    // 指针指向后面
  338   3                                              
  339   3                  DMA_SPIX_AMT(spi_n)  = (uint8)((tmp_len - 1) & 0xFF);                               // 设置传输总字节数(�
             -��8位)：n+1
  340   3                  DMA_SPIX_AMTH(spi_n) = (uint8)(((tmp_len - 1) & 0xFF00) >> 8);                      // 设置传输总字节数(
             -高8位)：n+1
  341   3                      
  342   3                  DMA_SPIX_TXAH(spi_n) = (uint8)((uint16)&tmp_buff[0] >> 8);                  // SPI发送数据存储地�
             -��
  343   3                  DMA_SPIX_TXAL(spi_n) = (uint8)((uint16)&tmp_buff[0]);
  344   3                              
  345   3                              DMA_SPIX_RXAH(spi_n) = (uint8)((uint16)&read_buffer[read_idx] >> 8);    // SPI接收数据存储地址
  346   3                  DMA_SPIX_RXAL(spi_n) = (uint8)((uint16)&read_buffer[read_idx]);
