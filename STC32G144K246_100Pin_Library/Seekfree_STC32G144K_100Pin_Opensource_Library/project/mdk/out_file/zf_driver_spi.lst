  585          //-------------------------------------------------------------------------------------------------------
             -------------
  586          void spi_dma_init(spi_index_enum spi_n, spi_mode_enum mode, uint32 baud, spi_pin_enum sck_pin, spi_pin_en
             -um mosi_pin, spi_pin_enum miso_pin, gpio_pin_enum cs_pin)
  587          {
  588   1          // 使用SPI_DMA CLK频率就必须要两分频，所以这里填写时钟
  589   1          uint32 spi_psc = 0;
  590   1          
  591   1          if((sck_pin & 0xFF00) != (mosi_pin & 0xFF00))
  592   1          {
  593   2              zf_assert(0);
  594   2              // SPI只能使用同一组引脚，不允许混用引脚
  595   2          }
  596   1          
  597   1          gpio_init(sck_pin  & 0xFF, GPO, 1, GPO_PUSH_PULL);
  598   1          gpio_init(mosi_pin & 0xFF, GPO, 1, GPO_PUSH_PULL);
  599   1          
  600   1          if(miso_pin != SPI_NULL_PIN)
  601   1          {
  602   2              gpio_init(miso_pin & 0xFF, GPI, 1, GPI_PULL_UP);
  603   2          }
  604   1          
  605   1          if(cs_pin != SPI_NULL_PIN)
  606   1          {
  607   2              gpio_init(cs_pin & 0xFF, GPO, 0, GPO_PUSH_PULL);
  608   2          }
  609   1      
  610   1        // 波特率大于等于10M就需要设置GPIO电平转换速度
  611   1        if(baud >= (10*1000*1000U))
  612   1        {
  613   2          gpio_set_level_speed(sck_pin  & 0xFF, GPIO_SPEED_FAST);
C251 COMPILER V5.60.0,  zf_driver_spi                                                      03/07/26  22:36:18  PAGE 12  

  614   2          gpio_set_level_speed(mosi_pin  & 0xFF, GPIO_SPEED_FAST);
  615   2          if(miso_pin != SPI_NULL_PIN)
  616   2          {
  617   3            gpio_set_level_speed(miso_pin & 0xFF, GPIO_SPEED_FAST);
  618   3          }
  619   2          if(cs_pin != SPI_NULL_PIN)
  620   2          {
  621   3            gpio_set_level_speed(cs_pin & 0xFF, GPIO_SPEED_FAST);
  622   3          }
  623   2        }
  624   1          
  625   1          switch(spi_n)
  626   1          {
  627   2              case SPI_1:
  628   2              {
  629   3                  P_SW1 &= ~(0x03 << 2); // 清除SPI_1引脚选择位
  630   3                  switch((sck_pin >> 8) & 0x03) 
  631   3                  {
  632   4                      case 0: P_SW1 |= 0x00 << 2; break;
  633   4                      case 1: P_SW1 |= 0x01 << 2; break;
  634   4                      case 2: P_SW1 |= 0x02 << 2; break;
  635   4                      case 3: P_SW1 |= 0x03 << 2; break;
  636   4                  }
  637   3      
  638   3                  SPCTL = 0; // 初始化SPI_1控制寄存器
  639   3                  SPCTL |= (1 << 7) | (1 << 4); // 忽略SS引脚 + 主机模式
  640   3                  
  641   3                  SPCTL |= 0x03; // 时钟/2
  642   3      
  643   3                  // 配置SPI_1极性相位
  644   3                  switch(mode) 
  645   3                  {
  646   4                      case SPI_MODE1: SPCTL |= 0x01 << 2; break;
  647   4                      case SPI_MODE2: SPCTL |= 0x02 << 2; break;
  648   4                      case SPI_MODE3: SPCTL |= 0x03 << 2; break;
  649   4                      default: break; // MODE0默认
  650   4                  }
  651   3                  SPCTL |= 1 << 6; // 使能SPI_1
  652   3                  break;
  653   3              }
  654   2              
  655   2              case SPI_2:
  656   2              {
  657   3                  P_SWX4 &= ~(0x03 << 0); // 清除SPI_2引脚选择位
  658   3                  switch((sck_pin >> 8) & 0x03) 
  659   3                  {
  660   4                      case 0: P_SWX4 |= 0x00 << 0; break;
  661   4                      case 1: P_SWX4 |= 0x01 << 0; break;
  662   4                      case 2: P_SWX4 |= 0x02 << 0; break;
  663   4                      case 3: P_SWX4 |= 0x03 << 0; break;
  664   4                  }
  665   3      
  666   3                  SPI2CTL = 0; // 初始化SPI_2控制寄存器
  667   3                  SPI2CTL |= (1 << 7) | (1 << 4); // 忽略SS引脚 + 主机模式
  668   3                  
  669   3                  spi_psc = system_clock / baud;
  670   3                  SPI2CTL |= 0x03; // 时钟/2
  671   3      
  672   3                  // 配置SPI_2极性相位
  673   3                  switch(mode) 
  674   3                  {
  675   4                      case SPI_MODE1: SPI2CTL |= 0x01 << 2; break;
  676   4                      case SPI_MODE2: SPI2CTL |= 0x02 << 2; break;
  677   4                      case SPI_MODE3: SPI2CTL |= 0x03 << 2; break;
  678   4                      default: break; // MODE0默认
  679   4                  }
C251 COMPILER V5.60.0,  zf_driver_spi                                                      03/07/26  22:36:18  PAGE 13  

  680   3                  SPI2CTL |= 1 << 6; // 使能SPI_2
  681   3                  break;
  682   3              }
  683   2      
  684   2              case SPI_3:
  685   2              {
  686   3                  P_SWX4 &= ~(0x03 << 2); // 清除SPI_3引脚选择位
  687   3                  switch((sck_pin >> 8) & 0x03) 
  688   3                  {
  689   4                      case 0: P_SWX4 |= 0x00 << 2; break;
  690   4                      case 1: P_SWX4 |= 0x01 << 2; break;
  691   4                      case 2: P_SWX4 |= 0x02 << 2; break;
  692   4                      case 3: P_SWX4 |= 0x03 << 2; break;
  693   4                  }
  694   3      
  695   3                  SPI3CTL = 0; // 初始化SPI_3控制寄存器
  696   3                  SPI3CTL |= (1 << 7) | (1 << 4); // 忽略SS引脚 + 主机模式
  697   3                  
  698   3                  
  699   3                  SPI3CTL |= 0x03; // 时钟/2
  700   3      
  701   3                  // 配置SPI_3极性相位
  702   3                  switch(mode) 
  703   3                  {
  704   4                      case SPI_MODE1: SPI3CTL |= 0x01 << 2; break;
  705   4                      case SPI_MODE2: SPI3CTL |= 0x02 << 2; break;
  706   4                      case SPI_MODE3: SPI3CTL |= 0x03 << 2; break;
  707   4                      default: break; // MODE0默认
  708   4                  }
