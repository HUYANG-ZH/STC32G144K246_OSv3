  142          /* 负压生效量计算: 基础量(无线 negative_pressure) + 触发增量, 上限 90。
  143             触发期间接管负压输出, 恢复后还原基础量。调用方为 TIM5 前的 5ms 控制链。 *
             -/
  144          static void app_speed_plan_update_pressure(void)
  145          {
  146   1          uint8 active;
  147   1          float effective;
  148   1          app_speedout_data_t speedout;
  149   1      
  150   1          /* 安全联锁(IMU/电感故障)期间不接管负压: TIM5 联锁路径会强制置 0,
  151   1             这里再写入会把联锁击穿, 因此联锁期间直接放弃本周期负压管理 */
  152   1          if(0U != app_speedout_get_safety_inhibit())
  153   1          {
  154   2              speed_plan_pressure_boost_active = 0U;
  155   2              return;
  156   2          }
  157   1      
  158   1          /* 车辆未启动(无线 stop/急停后 enabled=0)时不接管负压:
  159   1             否则 stop 后触发条件(如 |pitch|>30°)成立时会每 5ms 把负压重新拉起 */
  160   1          app_speedout_get_data(&speedout);
  161   1          if(speedout.enabled < 0.5f)
  162   1          {
  163   2              speed_plan_pressure_boost_active = 0U;
  164   2              return;
  165   2          }
  166   1      
  167   1          active = app_speed_plan_pressure_boost_condition();
  168   1          if(0U != active)
  169   1          {
  170   2              effective = tfpu_add(tfpu_int2float((long)service_negative_pressure_get_config_percent()),
  171   2                      speed_plan_pressure_boost);
  172   2              if(effective > APP_SPEED_PLAN_PRESSURE_MAX)
  173   2              {
  174   3                  effective = APP_SPEED_PLAN_PRESSURE_MAX;
  175   3              }
  176   2              service_negative_pressure_set_percent((uint8)(effective + 0.5f));
  177   2          }
  178   1          else if(0U != speed_plan_pressure_boost_active)
  179   1          {
  180   2              service_negative_pressure_set_percent(service_negative_pressure_get_config_percent());
  181   2          }
  182   1          speed_plan_pressure_boost_active = active;
  183   1      }
