  136          /* 负压生效量计算: 基础量(无线 negative_pressure) + 触发增量, 上限 90。
  137             触发期间接管负压输出, 恢复后还原基础量。调用方为 TIM5 前的 5ms 控制链。 *
             -/
  138          static void app_speed_plan_update_pressure(void)
  139          {
  140   1          uint8 active;
  141   1          float effective;
  142   1      
  143   1          /* 安全联锁(欠压/IMU/电感故障)期间不接管负压: TIM5 联锁路径会强制置 0,
  144   1             这里再写入会把联锁击穿, 因此联锁期间直接放弃本周期负压管理 */
  145   1          if(0U != app_speedout_get_safety_inhibit())
  146   1          {
  147   2              speed_plan_pressure_boost_active = 0U;
  148   2              return;
  149   2          }
  150   1      
  151   1          active = app_speed_plan_pressure_boost_condition();
  152   1          if(0U != active)
  153   1          {
  154   2              effective = tfpu_add(tfpu_int2float((long)service_negative_pressure_get_config_percent()),
  155   2                      speed_plan_pressure_boost);
  156   2              if(effective > APP_SPEED_PLAN_PRESSURE_MAX)
  157   2              {
  158   3                  effective = APP_SPEED_PLAN_PRESSURE_MAX;
  159   3              }
  160   2              service_negative_pressure_set_percent((uint8)(effective + 0.5f));
  161   2          }
  162   1          else if(0U != speed_plan_pressure_boost_active)
  163   1          {
  164   2              service_negative_pressure_set_percent(service_negative_pressure_get_config_percent());
  165   2          }
  166   1          speed_plan_pressure_boost_active = active;
  167   1      }
