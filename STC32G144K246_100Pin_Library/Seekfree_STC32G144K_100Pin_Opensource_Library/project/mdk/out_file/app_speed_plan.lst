  124          /* 负压生效量计算: 基础量(无线 negative_pressure) + 触发增量, 上限 90。
  125             触发期间接管负压输出, 恢复后还原基础量。调用方为 TIM5 前的 5ms 控制链。 *
             -/
  126          static void app_speed_plan_update_pressure(void)
  127          {
  128   1          uint8 active;
  129   1          float effective;
  130   1          app_speedout_data_t speedout;
  131   1      
  132   1          /* 安全联锁(IMU/电感故障)期间不接管负压: TIM5 联锁路径会强制置 0,
  133   1             这里再写入会把联锁击穿, 因此联锁期间直接放弃本周期负压管理 */
  134   1          if(0U != app_speedout_get_safety_inhibit())
  135   1          {
  136   2              speed_plan_pressure_boost_active = 0U;
  137   2              return;
  138   2          }
  139   1      
  140   1          /* 车辆未启动(无线 stop/急停后 enabled=0)时不接管负压:
  141   1             否则 stop 后触发条件(如 |pitch|>30°)成立时会每 5ms 把负压重新拉起 */
  142   1          app_speedout_get_data(&speedout);
  143   1          if(speedout.enabled < 0.5f)
  144   1          {
  145   2              speed_plan_pressure_boost_active = 0U;
  146   2              return;
  147   2          }
  148   1      
  149   1          active = app_speed_plan_pressure_boost_condition();
  150   1          if(0U != active)
  151   1          {
  152   2              effective = tfpu_add(tfpu_int2float((long)service_negative_pressure_get_config_percent()),
  153   2                      speed_plan_pressure_boost);
  154   2              if(effective > APP_SPEED_PLAN_PRESSURE_MAX)
  155   2              {
  156   3                  effective = APP_SPEED_PLAN_PRESSURE_MAX;
  157   3              }
  158   2              service_negative_pressure_set_percent((uint8)(effective + 0.5f));
  159   2          }
  160   1          else if(0U != speed_plan_pressure_boost_active)
  161   1          {
  162   2              service_negative_pressure_set_percent(service_negative_pressure_get_config_percent());
  163   2          }
  164   1          speed_plan_pressure_boost_active = active;
  165   1      }
