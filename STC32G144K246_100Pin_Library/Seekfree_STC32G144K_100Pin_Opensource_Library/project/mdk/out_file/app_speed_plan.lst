  120          /* 负压增量触发条件: TOF 接近(<200mm) 或 pitch(0-360) 偏离水平 (30,330) */
  121          static uint8 app_speed_plan_pressure_boost_condition(void)
  122          {
  123   1          app_attitude_data_t attitude;
  124   1      
  125   1          if(0U != app_speed_plan_tof_near_obstacle())
  126   1          {
