  122          /* 负压生效量计算: 基础量(无线 negative_pressure) - 衰减量(硬编码 10), 低于 0 按 0�
             -�
  123             触发期间接管负压输出, 恢复后还原基础量。调用方为 TIM5 前的 5ms 控制链。 *
             -/
  124          static void app_speed_plan_update_pressure(void)
  125          {
  126   1          uint8 active;
  127   1          float effective;
  128   1          app_speedout_data_t speedout;
  129   1      
  130   1          /* 安全联锁(IMU/电感故障)期间不接管负压: TIM5 联锁路径会强制置 0,
  131   1             这里再写入会把联锁击穿, 因此联锁期间直接放弃本周期负压管理 */
  132   1          if(0U != app_speedout_get_safety_inhibit())
  133   1          {
  134   2              speed_plan_pressure_decay_active = 0U;
  135   2              return;
  136   2          }
  137   1      
  138   1          /* 车辆未启动(无线 stop/急停后 enabled=0)时不接管负压:
  139   1             否则 stop 后触发条件成立时会每 5ms 把负压重新拉起 */
  140   1          app_speedout_get_data(&speedout);
  141   1          if(speedout.enabled < 0.5f)
  142   1          {
  143   2              speed_plan_pressure_decay_active = 0U;
  144   2              return;
  145   2          }
  146   1      
  147   1          active = app_speed_plan_pressure_decay_condition();
  148   1          if(0U != active)
  149   1          {
  150   2              effective = tfpu_sub(tfpu_int2float((long)service_negative_pressure_get_config_percent()),
  151   2                      APP_SPEED_PLAN_PRESSURE_DECAY);
  152   2              if(effective < 0.0f)
  153   2              {
  154   3                  effective = 0.0f;
  155   3              }
  156   2              service_negative_pressure_set_percent((uint8)(effective + 0.5f));
  157   2          }
  158   1          else if(0U != speed_plan_pressure_decay_active)
  159   1          {
  160   2              service_negative_pressure_set_percent(service_negative_pressure_get_config_percent());
  161   2          }
  162   1          speed_plan_pressure_decay_active = active;
  163   1      }
