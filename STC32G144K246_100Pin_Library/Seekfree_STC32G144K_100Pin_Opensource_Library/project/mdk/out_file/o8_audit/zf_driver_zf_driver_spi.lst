  965   2                              while (!(SPSTAT & 0x80));  
  966   2                              break;                  
  967   2                      case SPI_2:
  968   2                  SPI2STAT = 0xc0;              
  969   2                              SPI2DAT = dat;                          
  970   2                              while (!(SPI2STAT & 0x80));
  971   2                              break;     
  972   2              case SPI_3:
  973   2                  SPI3STAT = 0xc0;              
  974   2                              SPI3DAT = dat;                          
  975   2                              while (!(SPI3STAT & 0x80));  
  976   2                              break;           
