  604          // 参数说明       x               坐标x方向的起点 参数范围 [0, ips114_x_max-1]
  605          // 参数说明       y               坐标y方向的起点 参数范围 [0, ips114_y_max-1]
  606          // 参数说明       siz            取模的时候设置的汉字字体大小 也就是一个汉字占�
             -��的点阵长宽为多少个点 取模的时候需要长宽是一样的
  607          // 参数说明       *p              需要显示的汉字数组
  608          // 参数说明       number          需要显示多少位
  609          // 参数说明       color           显示颜色
  610          // 返回参数      void
  611          // 使用示例                ips114_show_chinese(0,0,16,chinese_test[0],4,RED);//显示font文件里面
             -的 示例
  612          // 备注信息                        使用PCtoLCD2002软件取模           阴码、逐行式、顺�
             -�   16*16
  613          //-------------------------------------------------------------------------------------------------------
             -------------
  614          void ips114_show_chinese (uint16 x, uint16 y, uint8 siz, const uint8 *p, uint8 number, uint16 color)
  615          {
  616   1      
  617   1          int i, j, k; 
  618   1          uint8 temp, temp1, temp2;
  619   1          const uint8 *p_data;
  620   1              
  621   1              zf_assert(x < ips114_x_max);
  622   1          zf_assert(y < ips114_y_max);
  623   1      
  624   1          temp2 = siz/8;
  625   1          
  626   1          ips114_set_region(x,y,number*siz-1+x,y+siz-1);
  627   1          
  628   1          for(i=0;i<siz;i++)
  629   1          {
  630   2              temp1 = number;
  631   2              p_data = p+i*temp2;
  632   2              while(temp1--)
  633   2              {
  634   3                  for(k=0;k<temp2;k++)
  635   3                  {
  636   4                      for(j=8;j>0;j--)
  637   4                      {
  638   5                          temp = (*p_data>>(j-1)) & 0x01;
  639   5                          if(temp)    ips114_write_16bit_data(color);
  640   5                          else        ips114_write_16bit_data(ips114_bgcolor);
  641   5                      }
  642   4                      p_data++;
  643   4                  }
  644   3                  p_data = p_data - temp2 + temp2*siz;
  645   3              }   
  646   2          }
  647   1      }
