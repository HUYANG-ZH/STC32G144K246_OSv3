  312          static uint8 imu660ra_self_check (void)
  313          {
  314   1          uint8 dat = 0, return_state = 0;
  315   1          uint16 timeout_count = 0;
  316   1          
  317   1          do
  318   1          {
  319   2              if(timeout_count ++ > IMU660RA_TIMEOUT_COUNT)
  320   2              {
  321   3                  return_state =  1;
  322   3                  break;
  323   3              }
  324   2              
  325   2              dat = imu660ra_read_register(IMU660RA_CHIP_ID);
  326   2              system_delay_ms(1);
  327   2          }
  328   1          while(0x24 != dat);                                                     // 读取设备ID是否等于
             -0X24，如果不是0X24则认为没检测到设备
  329   1              // printf("imu660ra_self_check = 0x%X\r\n", dat);
  330   1          return return_state;
  331   1      }
