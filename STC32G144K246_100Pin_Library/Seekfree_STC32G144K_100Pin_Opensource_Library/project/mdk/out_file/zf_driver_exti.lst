   53   2              switch(mode)
   54   2          {
   55   3                  case BOTH: 
   56   3                      IT0 = 0;
   57   3                      break;
   58   3                  
   59   3            case FALLING_EDGE: 
   60   3                      IT0 = 1;
   61   3              break;
   62   3                  
   63   3            default:
   64   3                      zf_assert(0);
   65   3              break;
   66   3          }
