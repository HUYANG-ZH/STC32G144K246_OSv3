  338   1      
  339   1          // 三元运算符精简置位/清零逻辑
  340   1          switch(port_flag)
  341   1          {
  342   2              case IO_P00: dat ? (P0 |= (1 << pin_bit)) : (P0 &= ~(1 << pin_bit)); break;
  343   2              case IO_P10: dat ? (P1 |= (1 << pin_bit)) : (P1 &= ~(1 << pin_bit)); break;
  344   2              case IO_P20: dat ? (P2 |= (1 << pin_bit)) : (P2 &= ~(1 << pin_bit)); break;
  345   2              case IO_P30: dat ? (P3 |= (1 << pin_bit)) : (P3 &= ~(1 << pin_bit)); break;
  346   2              case IO_P40: dat ? (P4 |= (1 << pin_bit)) : (P4 &= ~(1 << pin_bit)); break;
  347   2              case IO_P50: dat ? (P5 |= (1 << pin_bit)) : (P5 &= ~(1 << pin_bit)); break;
  348   2              case IO_P60: dat ? (P6 |= (1 << pin_bit)) : (P6 &= ~(1 << pin_bit)); break;
  349   2              case IO_P70: dat ? (P7 |= (1 << pin_bit)) : (P7 &= ~(1 << pin_bit)); break;
  350   2              
  351   2              case IO_P80: dat ? (P8OUT |= (1 << pin_bit)) : (P8OUT &= ~(1 << pin_bit)); break;
  352   2              case IO_P90: dat ? (P9OUT |= (1 << pin_bit)) : (P9OUT &= ~(1 << pin_bit)); break;
  353   2              case IO_PA0: dat ? (PAOUT |= (1 << pin_bit)) : (PAOUT &= ~(1 << pin_bit)); break;
  354   2              case IO_PB0: dat ? (PBOUT |= (1 << pin_bit)) : (PBOUT &= ~(1 << pin_bit)); break;
  355   2              
  356   2              default: break; // 无效引脚
  357   2          }
  358   1      }
