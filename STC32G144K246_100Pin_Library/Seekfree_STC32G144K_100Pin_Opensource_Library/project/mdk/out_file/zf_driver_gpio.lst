  380          // 使用示例     gpio_init(D0, GPO, 1, GPO_PUSH_PULL);//D0初始化为输出、高电平、推挽模�
             -�
  381          //-------------------------------------------------------------------------------------------------------
             -------------
  382          void gpio_init(gpio_pin_enum pin, gpio_dir_enum dir, const uint8 dat, gpio_mode_enum mode)
  383          {
  384   1              zf_assert(dir == ((uint8)mode >> 4));
  385   1      
  386   1          if(dir == GPI)
  387   1              {
  388   2                      if(mode == GPI_IMPEDANCE)
  389   2                      {
  390   3                  gpio_set_impedance(pin);
  391   3                  gpio_set_ie(pin, GPIO_DIGITAL_IN_ENABLE);
  392   3                      }
  393   2                      else if(mode == GPI_PULL_UP)
  394   2                      {
  395   3                  gpio_set_impedance(pin);
  396   3                              gpio_set_up(pin); 
  397   3                  gpio_set_ie(pin, GPIO_DIGITAL_IN_ENABLE);
  398   3      //            gpio_set_level_speed(pin, GPIO_SPEED_FAST);
  399   3                      }
  400   2              else if(mode == GPI_ANALOG)
  401   2              {
  402   3                  gpio_set_impedance(pin);
  403   3                  gpio_set_ie(pin, GPIO_DIGITAL_IN_DISABLE);
  404   3              }
  405   2              else if(mode == GPI_PULL_DOWN)
  406   2              {
  407   3                  gpio_set_impedance(pin);
  408   3                  gpio_set_pd(pin);
  409   3              }
  410   2              }
  411   1              else if(dir == GPO)
  412   1              {
  413   2                      if(mode == GPO_PUSH_PULL)
  414   2                      {
  415   3                  gpio_set_push_pull(pin);
  416   3                  gpio_set_dr(pin, GPIO_DRIVE_ENHANCE);
  417   3                      }
  418   2                      else if(mode == GPO_OPEN_DTAIN)
  419   2                      {
  420   3                              gpio_set_open_drain(pin);
  421   3                      }
  422   2              gpio_set_level(pin, dat);
  423   2              }
  424   1      
  425   1      }


