  308   2              case IO_P10: status = P1 & (1 << pin_bit); break;
  309   2              case IO_P20: status = P2 & (1 << pin_bit); break;
  310   2              case IO_P30: status = P3 & (1 << pin_bit); break;
  311   2              case IO_P40: status = P4 & (1 << pin_bit); break;
  312   2              case IO_P50: status = P5 & (1 << pin_bit); break;
  313   2              case IO_P60: status = P6 & (1 << pin_bit); break;
  314   2              case IO_P70: status = P7 & (1 << pin_bit); break;
  315   2              
  316   2              case IO_P80: status = P8IN & (1 << pin_bit); break;
  317   2              case IO_P90: status = P9IN & (1 << pin_bit); break;
  318   2              case IO_PA0: status = PAIN & (1 << pin_bit); break;
  319   2              case IO_PB0: status = PBIN & (1 << pin_bit); break;
  320   2      
  321   2              default: break; // 无效引脚
  322   2          }
  323   1          
  324   1          return status ? 1 : 0; // 转换为0/1返回
