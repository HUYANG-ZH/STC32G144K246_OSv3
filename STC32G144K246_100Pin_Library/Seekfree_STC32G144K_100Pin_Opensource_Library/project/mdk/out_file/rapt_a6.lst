  404          /* Baseline implementation: heap-layout complete trees, uint8 thresholds,
  405           * int8 leaves, int32 accumulator. One sample = RAPT_K x RAPT_DEPTH compares. */
  406          uint8 roundabout_priority_tree_predict(uint16 CH1, uint16 CH2, uint16 CH3,
  407                                                 uint16 CH4, uint16 TOF)
  408          {
  409   1          uint8 x[10];
  410   1          int32 acc = 0;
  411   1          uint8 lv;
  412   1          int t, idx;
  413   1          {
  414   2              uint8 c1 = CH1 > 255u ? 255u : (uint8)CH1;
  415   2              uint8 c2 = CH2 > 255u ? 255u : (uint8)CH2;
  416   2              uint8 c3 = CH3 > 255u ? 255u : (uint8)CH3;
  417   2              uint8 c4 = CH4 > 255u ? 255u : (uint8)CH4;
  418   2              uint32 q = (uint32)TOF / 32u, r = (uint32)TOF % 32u;
  419   2              uint8 tf;
  420   2              int v;
  421   2              if (r > 16u) q += 1u;
  422   2              else if (r == 16u) q += (q & 1u);          /* round half to even, matches training */
  423   2              tf = q > 255u ? 255u : (uint8)q;
  424   2              x[0] = c1; x[1] = c2; x[2] = c3; x[3] = c4; x[4] = tf;
  425   2              v = ((int)c4 - (int)c1 + 268) / 2;  x[5] = (uint8)(v > 255 ? 255 : v);
  426   2              v = ((int)c2 - (int)c3 + 148) / 2;  x[6] = (uint8)(v > 255 ? 255 : v);
  427   2              v = (int)c2 + (int)c3;              x[7] = (uint8)(v > 255 ? 255 : v);
  428   2              v = ((int)c1 + (int)c4) / 2;        x[8] = (uint8)(v > 255 ? 255 : v);
  429   2              v = c1 > c4 ? (int)c1 - (int)c4 : (int)c4 - (int)c1;
  430   2                                                  x[9] = (uint8)(v > 255 ? 255 : v);
  431   2          }
  432   1          for (t = 0; t < RAPT_K; ++t) {
  433   2              idx = 0;
  434   2              for (lv = 0; lv < RAPT_DEPTH; ++lv)
  435   2                  idx = idx * 2 + 1 + (x[rapt_feat[t][idx]] > rapt_thr[t][idx]);
  436   2              acc += rapt_leaf[t][idx - RAPT_NODES];
  437   2          }
  438   1          return (acc >= RAPT_TAU) ? (uint8)1 : (uint8)0;
  439   1      }
