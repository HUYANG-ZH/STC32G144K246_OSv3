  500                      iic_hw_configure(iic_n);
  501                      iic_async_finish(iic_n, IIC_ERROR_TIMEOUT);
  502                  }
  503                  return;
  504              }
  505          
  506              async_info->service_count = 0U;
  507              if(0U != timed)
  508              {
  509                  async_info->last_progress_tick = now_tick;
  510                  async_info->timebase_valid = 1U;
  511              }
  512              iic_hw_clear_if(iic_n);
  513          
  514              switch(async_info->state)
  515              {
  516                  case IIC_ASYNC_STATE_START_WRITE:
