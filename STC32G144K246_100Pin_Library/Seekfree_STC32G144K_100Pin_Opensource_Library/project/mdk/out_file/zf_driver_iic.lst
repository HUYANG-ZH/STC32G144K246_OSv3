  663              iic_hw_clear_if(iic_n);
  664              iic_hw_set_command(iic_n, command);
  665          
  666              while(0 == (iic_hw_get_status(iic_n) & IIC_STATUS_IF))
  667              {
  668                  if(0 == timeout --)
  669                  {
  670                      return IIC_ERROR_TIMEOUT;
  671                  }
  672              }
  673          
  674              iic_hw_clear_if(iic_n);
  675              return IIC_SUCCESS;
  676          }
