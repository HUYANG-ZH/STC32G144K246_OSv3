  196          // 函数简�?    检查引脚与 IIC 编号、通道是否严格匹配
  197          //-------------------------------------------------------------------------------------------------------
             -------------
  198          static uint8 iic_check_pin_pair (iic_index_enum iic_n, iic_pin_enum scl_pin, iic_pin_enum sda_pin)
  199          {
  200              uint16 group_code;
  201          
  202              if((0 == iic_index_is_valid(iic_n)) || (IIC_NULL_PIN == scl_pin) || (IIC_NULL_PIN == sda_pin))
  203              {
  204                  return 0;
  205              }
  206          
  207              if((scl_pin & 0xFF00U) != (sda_pin & 0xFF00U))
  208              {
  209                  return 0;
  210              }
  211          
  212              group_code = (uint16)(scl_pin & 0xFF00U);
  213          
  214              switch(iic_n)
  215              {
  216                  case IIC_1:
  217                  {
  218                      switch(group_code)
  219                      {
  220                          case 0x0000: return (((scl_pin & 0xFFU) == IO_P15) && ((sda_pin & 0xFFU) == IO_P14));
  221                          case 0x0100: return (((scl_pin & 0xFFU) == IO_P25) && ((sda_pin & 0xFFU) == IO_P24));
  222                          case 0x0200: return (((scl_pin & 0xFFU) == IO_P77) && ((sda_pin & 0xFFU) == IO_P76));
  223                          case 0x0300: return (((scl_pin & 0xFFU) == IO_P32) && ((sda_pin & 0xFFU) == IO_P33));
  224                          default:     return 0;
  225                      }
C251 COMPILER V5.60.0,  zf_driver_iic                                                      29/07/26  01:04:22  PAGE 5   

  226                  }
  227          
  228                  case IIC_2:
  229                  {
  230                      switch(group_code)
  231                      {
  232                          case 0x1000: return (((scl_pin & 0xFFU) == IO_P27) && ((sda_pin & 0xFFU) == IO_P26));
  233                          case 0x1100: return (((scl_pin & 0xFFU) == IO_P37) && ((sda_pin & 0xFFU) == IO_P36));
  234                          case 0x1200: return (((scl_pin & 0xFFU) == IO_P17) && ((sda_pin & 0xFFU) == IO_P16));
  235                          case 0x1300: return (((scl_pin & 0xFFU) == IO_P61) && ((sda_pin & 0xFFU) == IO_P60));
  236                          default:     return 0;
  237                      }
  238                  }
  239          
  240                  case IIC_NUM:
  241                  default:
  242                  {
  243                      return 0;
  244                  }
  245              }
  246          }
