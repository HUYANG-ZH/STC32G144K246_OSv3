  628          //-------------------------------------------------------------------------------------------------------
             -------------
  629          // 函数简�?    总线恢复专用短延时。使�?CPU 空循环，不占用工程中�?Timer11 或�
             -�他硬件定时器�?
  630          // 备注信息     总线恢复只要求脉冲不短于目标值，不参与正�?IIC 位时序；实际
             -延时允许略长�?
  631          //-------------------------------------------------------------------------------------------------------
             -------------
  632          static void iic_recovery_delay_us (uint16 period_us)
  633          {
  634              volatile uint32 delay_count;
  635              uint32 loops_per_us;
  636          
  637              loops_per_us = system_clock / 1000000UL;
  638              if(0U == loops_per_us)
  639              {
  640                  loops_per_us = 1U;
  641              }
  642          
  643              if(0U == period_us)
  644              {
  645                  period_us = 1U;
  646              }
  647          
  648              delay_count = loops_per_us * (uint32)period_us;
  649              while(delay_count)
  650              {
  651                  delay_count --;
  652                  _nop_();
  653              }
  654          }
