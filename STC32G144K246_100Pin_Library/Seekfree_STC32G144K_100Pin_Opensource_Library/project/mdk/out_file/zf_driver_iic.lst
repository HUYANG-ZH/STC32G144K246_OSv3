  523                          iic_hw_set_tx(iic_n, async_info->write_data[async_info->write_pos++]);
  524                          async_info->state = IIC_ASYNC_STATE_WRITE;
  525                          iic_async_issue_command(iic_n, IIC_CMD_SEND_ACK_COMBINED);
  526                      }
  527                      break;
  528          
  529                  case IIC_ASYNC_STATE_WRITE:
