  249          // 函数简�?    设置复用引脚，且不破坏同一寄存器中的其他外设位
  250          //-------------------------------------------------------------------------------------------------------
             -------------
  251          static void iic_set_pin_mux (iic_index_enum iic_n, uint8 pin_group)
  252          {
  253              uint8 ea_backup;
  254          
  255              ea_backup = EA;
  256              EA = 0;
  257              EAXFR = 1;
  258          
  259              if(IIC_1 == iic_n)
  260              {
  261                  P_SW2 = (uint8)((P_SW2 & (uint8)(~0x30U)) | ((pin_group & 0x03U) << 4));
  262              }
  263              else
  264              {
  265                  P_SWX4 = (uint8)((P_SWX4 & (uint8)(~0xC0U)) | ((pin_group & 0x03U) << 6));
  266              }
  267          
  268              EA = ea_backup;
  269          }
  270          
  271          //-------------------------------------------------------------------------------------------------------
             -------------
  272          // 函数简�?    计算 14 �?I2CMSSPEED，结果取“不高于请求速度”的最近�?
  273          //-------------------------------------------------------------------------------------------------------
             -------------
  274          static uint16 iic_calculate_divider (uint32 speed)
  275          {
  276              uint32 required_divisor;
  277              uint32 divider;
  278          
  279              required_divisor = system_clock / speed;
  280              if(system_clock % speed)
  281              {
  282                  required_divisor ++;
  283              }
  284          
  285              if(required_divisor <= 8U)
  286              {
  287                  divider = 0;
C251 COMPILER V5.60.0,  zf_driver_iic                                                      29/07/26  01:04:22  PAGE 6   

  288              }
  289              else
  290              {
  291                  divider = (required_divisor - 8U + 3U) / 4U;
  292              }
  293          
  294              if(divider > 0x3FFFU)
  295              {
  296                  divider = 0x3FFFU;
  297              }
  298          
  299              return (uint16)divider;
  300          }
  301          
  302          static uint32 iic_calculate_actual_speed (uint16 divider)
  303          {
  304              uint32 denominator = ((uint32)divider * 4U) + 8U;
  305              return system_clock / denominator;
  306          }
  307          
  308          static uint32 iic_calculate_min_speed (void)
  309          {
  310              uint32 denominator = ((uint32)0x3FFFU * 4U) + 8U;
  311              uint32 min_speed = system_clock / denominator;
  312          
  313              if(system_clock % denominator)
  314              {
  315                  min_speed ++;
  316              }
  317              return min_speed;
  318          }
