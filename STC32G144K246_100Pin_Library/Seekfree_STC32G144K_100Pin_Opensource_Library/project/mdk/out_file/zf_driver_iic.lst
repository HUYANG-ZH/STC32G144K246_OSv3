  323          static void iic_hw_configure (iic_index_enum iic_n)
  324          {
  325              uint8 cfg;
  326          
  327              iic_hw_set_cfg(iic_n, 0x00);
  328              iic_hw_set_aux(iic_n, 0x00);
  329              iic_hw_set_command(iic_n, 0x00);
  330              iic_hw_clear_if(iic_n);
  331              iic_hw_set_prescaler(iic_n, (uint8)(iic_info[iic_n].divider >> 6));
  332          
  333              cfg = (uint8)(IIC_CFG_MASTER | (iic_info[iic_n].divider & 0x3FU));
  334              iic_hw_set_cfg(iic_n, cfg);
  335              iic_hw_set_cfg(iic_n, (uint8)(cfg | IIC_CFG_ENABLE));
  336          }
