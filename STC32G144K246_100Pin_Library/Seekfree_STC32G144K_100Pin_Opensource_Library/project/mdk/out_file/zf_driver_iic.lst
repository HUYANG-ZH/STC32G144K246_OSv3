  679          // 函数简�?    GPIO 层总线恢复：最�?9 �?SCL 脉冲并生�?STOP�?
  680          //-------------------------------------------------------------------------------------------------------
             -------------
  681          static iic_status_enum iic_recover_bus_internal (iic_index_enum iic_n)
  682          {
  683              uint8 pulse_count;
  684              uint16 wait_count;
  685              gpio_pin_enum scl_pin = iic_info[iic_n].scl_pin;
  686              gpio_pin_enum sda_pin = iic_info[iic_n].sda_pin;
  687          
  688              iic_hw_set_cfg(iic_n, (uint8)(iic_hw_get_cfg(iic_n) & (uint8)(~IIC_CFG_ENABLE)));
  689          
  690              gpio_init(scl_pin, GPO, GPIO_HIGH, GPO_OPEN_DTAIN);
  691              gpio_init(sda_pin, GPO, GPIO_HIGH, GPO_OPEN_DTAIN);
  692              iic_set_digital_input(scl_pin, GPIO_DIGITAL_IN_ENABLE);
  693              iic_set_digital_input(sda_pin, GPIO_DIGITAL_IN_ENABLE);
  694              iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  695          
  696              // SCL 被目标器件永久拉低时，主机无法恢复，只能明确返回错误�?
  697              wait_count = 1000U;
  698              while((0 == gpio_get_level(scl_pin)) && wait_count --)
  699              {
  700                  iic_recovery_delay_us(1);
  701              }
  702              if(0 == gpio_get_level(scl_pin))
  703              {
  704                  iic_hw_configure(iic_n);
  705                  return IIC_ERROR_BUS_STUCK;
  706              }
  707          
  708              for(pulse_count = 0; (pulse_count < 9U) && (0 == gpio_get_level(sda_pin)); pulse_count ++)
  709              {
  710                  gpio_low(scl_pin);
  711                  iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  712                  gpio_high(scl_pin);
  713          
  714                  wait_count = 1000U;
  715                  while((0 == gpio_get_level(scl_pin)) && wait_count --)
  716                  {
  717                      iic_recovery_delay_us(1);
  718                  }
  719                  if(0 == gpio_get_level(scl_pin))
  720                  {
  721                      iic_hw_configure(iic_n);
  722                      return IIC_ERROR_BUS_STUCK;
  723                  }
  724                  iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  725              }
  726          
C251 COMPILER V5.60.0,  zf_driver_iic                                                      29/07/26  01:04:22  PAGE 13  

  727              // 生成一个标�?STOP：SDA �?-> SCL �?-> SDA 高�?
  728              gpio_low(sda_pin);
  729              iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  730              gpio_high(scl_pin);
  731              iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  732              gpio_high(sda_pin);
  733              iic_recovery_delay_us(IIC_RECOVERY_PULSE_US);
  734          
  735              iic_set_pin_mux(iic_n, iic_info[iic_n].pin_group);
  736              iic_hw_configure(iic_n);
  737          
  738              if((0 == gpio_get_level(scl_pin)) || (0 == gpio_get_level(sda_pin)))
  739              {
  740                  return IIC_ERROR_BUS_STUCK;
  741              }
  742          
  743              return IIC_SUCCESS;
  744          }
