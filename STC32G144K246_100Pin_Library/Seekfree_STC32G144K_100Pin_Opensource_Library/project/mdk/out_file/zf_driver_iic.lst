  371          static void iic_async_issue_command (iic_index_enum iic_n, uint8 command)
  372          {
  373              iic_hw_clear_if(iic_n);
  374              iic_hw_set_command(iic_n, command);
  375          }
  376          
  377          static void iic_async_finish (iic_index_enum iic_n, iic_status_enum status)
  378          {
  379              iic_async_info[iic_n].state = IIC_ASYNC_STATE_IDLE;
  380              iic_async_info[iic_n].status = status;
  381              iic_async_info[iic_n].timebase_valid = 0U;
  382              iic_set_last_status(iic_n, status);
  383              iic_unlock(iic_n);
  384          }
  385          
  386          static void iic_async_begin_stop (iic_index_enum iic_n, iic_status_enum final_status)
  387          {
  388              iic_async_info[iic_n].pending_status = final_status;
  389              iic_async_info[iic_n].state = (IIC_SUCCESS == final_status) ?
  390                      IIC_ASYNC_STATE_STOP_SUCCESS : IIC_ASYNC_STATE_STOP_ERROR;
  391              iic_async_issue_command(iic_n, IIC_CMD_STOP);
  392          }
