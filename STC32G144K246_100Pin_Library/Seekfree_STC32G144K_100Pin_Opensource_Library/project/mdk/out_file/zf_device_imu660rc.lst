  316          static uint32 fp16_to_float(uint16 h)
  317          {
  318   1          uint32 f_sgn;
  319   1          uint16 h_exp;
  320   1          uint32 f_exp;
  321   1          uint32 f_sig;
  322   1          
  323   1          h_exp = (h & 0x7c00u);
  324   1          f_sgn = ((uint32)h & 0x8000u) << 16;
  325   1          switch (h_exp)
  326   1          {
  327   2              case 0x0000u:   // 0 or subnormal
  328   2              {
  329   3                  uint16 h_sig = (h & 0x03ffu);
  330   3                  // Signed zero
  331   3                  if (h_sig == 0)
  332   3                  {
  333   4                      return f_sgn;
  334   4                  }
  335   3                  // Subnormal
  336   3                  h_sig <<= 1;
  337   3                  while ((h_sig & 0x0400u) == 0)
  338   3                  {
  339   4                      h_sig <<= 1;
  340   4                      h_exp++;
  341   4                  }
  342   3                  f_exp = ((uint32)(127 - 15 - h_exp)) << 23;
  343   3                  f_sig = ((uint32)(h_sig & 0x03ffu)) << 13;
  344   3                  return f_sgn + f_exp + f_sig;
  345   3              }
C251 COMPILER V5.60.0,  zf_device_imu660rc                                                 20/05/26  14:47:17  PAGE 7   

  346   2              case 0x7c00u: // inf or NaN
  347   2              {
  348   3                  // All-ones exponent and a copy of the significand
  349   3                  return f_sgn + 0x7f800000u + (((uint32)(h & 0x03ffu)) << 13);
  350   3              }
  351   2              default: // normalized
  352   2              {
  353   3                  // Just need to adjust the exponent and shift
  354   3                  return f_sgn + (((uint32)(h & 0x7fffu) + 0x1c000u) << 13);
  355   3              }
  356   2          }
  357   1      }
