  410   2          }
  411   1          else
  412   1          {
  413   2              if(y > 0.0f)
  414   2              {
  415   3                  value = IMU660RC_HALF_PI;
  416   3              }
  417   2              else if(y < 0.0f)
  418   2              {
  419   3                  value = tfpu_sub(0.0f, IMU660RC_HALF_PI);
