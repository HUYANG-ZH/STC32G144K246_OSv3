  448          static void quarternion_to_euler(float quat[4], float *roll, float *pitch, float *yaw)
  449          {
  450   1          float euler[3];
  451   1          float temp_a;
  452   1          float temp_b;
  453   1      
  454   1          float sqx = tfpu_mul(quat[0], quat[0]);
  455   1          float sqy = tfpu_mul(quat[1], quat[1]);
  456   1          float sqz = tfpu_mul(quat[2], quat[2]);
  457   1      
