  366          static void quarternion_normalize(float quat[4], uint16 *fp16)
  367          {
  368   1          float n = 0;
  369   1          float temp[4];
  370   1          
  371   1          *(uint32 *)(&temp[0]) = fp16_to_float(fp16[0]);
  372   1          *(uint32 *)(&temp[1]) = fp16_to_float(fp16[1]);
  373   1          *(uint32 *)(&temp[2]) = fp16_to_float(fp16[2]);
  374   1          *(uint32 *)(&temp[3]) = fp16_to_float(fp16[3]);
  375   1          
  376   1          n = tfpu_add(tfpu_add(tfpu_mul(temp[0], temp[0]), tfpu_mul(temp[1], temp[1])),
  377   1                  tfpu_add(tfpu_mul(temp[2], temp[2]), tfpu_mul(temp[3], temp[3])));
  378   1          n = tfpu_sqrt(n);
  379   1          
  380   1          if(n > 0.001f)  // 避免除以接近0的值
  381   1          {
  382   2              n = temp[3] < 0.0f ? tfpu_sub(0.0f, n) : n;
  383   2              
  384   2              quat[0] = tfpu_div(temp[1], n);
  385   2              quat[1] = tfpu_div(temp[2], n);
  386   2              quat[2] = tfpu_div(temp[0], n);
  387   2              quat[3] = tfpu_div(temp[3], n);
  388   2          }
  389   1      }
