   17          #define BSP_INDUCTOR_DMA_DATA_BYTES           ((BSP_INDUCTOR_DMA_SAMPLES * 2U) + 4U)
   18          #define BSP_INDUCTOR_DMA_CHSW0                (0xD8U)     /* ADC2 CH3,CH4,CH6,CH7 (不含 CH5/M) */
   19          
   20          enum
