  801          
  802          /* Baseline implementation: heap-layout complete trees, uint8 thresholds,
  803           * int8 leaves, int32 accumulator. One sample = RAPT_K x RAPT_DEPTH compares. */
  804          uint8 roundabout_priority_tree_predict(uint16 CH1, uint16 CH2, uint16 CH3,
  805                                                 uint16 CH4, uint16 TOF)
  806          {
  807   1          uint8 x[10];
  808   1          uint8 c1;
  809   1          uint8 c2;
  810   1          uint8 c3;
  811   1          uint8 c4;
  812   1          uint8 tf;
  813   1          uint32 q;
  814   1          uint32 r;
  815   1          int v;
  816   1          int32 acc;
  817   1          int t;
  818   1          int idx;
  819   1          int lv;
  820   1      
  821   1          {
  822   2              c1 = CH1 > 255u ? 255u : (uint8)CH1;
  823   2              c2 = CH2 > 255u ? 255u : (uint8)CH2;
  824   2              c3 = CH3 > 255u ? 255u : (uint8)CH3;
  825   2              c4 = CH4 > 255u ? 255u : (uint8)CH4;
  826   2              q = (uint32)TOF / 32u;
  827   2              r = (uint32)TOF % 32u;
  828   2              if (r > 16u) q += 1u;
  829   2              else if (r == 16u) q += (q & 1u);          /* round half to even, matches training */
  830   2              tf = q > 255u ? 255u : (uint8)q;
  831   2              x[0] = c1; x[1] = c2; x[2] = c3; x[3] = c4; x[4] = tf;
  832   2              v = ((int)c4 - (int)c1 + 168) / 2;  x[5] = (uint8)(v > 255 ? 255 : v);
  833   2              v = ((int)c2 - (int)c3 + 168) / 2;  x[6] = (uint8)(v > 255 ? 255 : v);
  834   2              v = (int)c2 + (int)c3;              x[7] = (uint8)(v > 255 ? 255 : v);
  835   2              v = ((int)c1 + (int)c4) / 2;        x[8] = (uint8)(v > 255 ? 255 : v);
  836   2              v = c1 > c4 ? (int)c1 - (int)c4 : (int)c4 - (int)c1;
  837   2                                                  x[9] = (uint8)(v > 255 ? 255 : v);
  838   2          }
  839   1          acc = 0;
  840   1          for (t = 0; t < RAPT_K; ++t) {
  841   2              idx = 0;
  842   2              for (lv = 0; lv < RAPT_DEPTH; ++lv)
  843   2                  idx = idx * 2 + 1 + (x[rapt_feat[t][idx]] > rapt_thr[t][idx]);
  844   2              acc += rapt_leaf[t][idx - RAPT_NODES];
  845   2          }
  846   1          return (acc >= RAPT_TAU) ? (uint8)1 : (uint8)0;
  847   1      }
