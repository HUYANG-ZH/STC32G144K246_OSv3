                       // 参数说明     len             数据长度
                       // 返回参数     void
                       // 使用示例     imu660rb_read_registers(IMU660RB_ACC_ADDRESS, dat, 6);
                       // 备注信息     内部调用
                       //------------------------------------------------------------------------------------------------------
             --------------
                       static void imu660rb_read_registers(uint8 reg, uint8 *dat, uint32 len)
                       {
                               IMU660RB_CS(0);
                               imu660rb_simspi_r_reg_bytes(reg | IMU660RB_SPI_R, dat, len);
                               IMU660RB_CS(1);
                       }
                       
                       
               
