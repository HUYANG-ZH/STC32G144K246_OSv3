  235          // 函数简介     扩展EEPROM写多个字节(无需擦除)，
  236          // 参数说明     addr                        需要写的eeprom地址   
  237          // 参数说明     *buf                        需要写的数据地址
  238          // 参数说明     len                         需要写的数据长度
  239          // 返回参数     void
  240          // 备注信息
  241          // 使用示例                                         extern_iap_write_bytes(0x0000,(uint8 *)"0123456789",10);
  242          //                                                              将"0123456789"写入0x00-0x0A地址中;
  243          // 注意事项                                         不要跨扇区使用。
  244          //                                                              addr地址：0-511为一个扇区,512-1023为一个扇区，1024-1535为一个扇区，依次�
             -�推
  245          //-------------------------------------------------------------------------------------------------------
             -------------
  246          void extern_iap_write_buff(uint16 addr, uint8 *buf, uint16 len)
  247          {
  248   1          uint8 temp[512] = {0};
  249   1          uint16 i;
  250   1          
  251   1          for(i = 0; i < 512 ; i++)   temp[i] = 0;                                            //清0
  252   1          
  253   1          iap_read_buff(addr & 0xFE00, temp, 512);                                            //读取
  254   1          
  255   1          for(i = 0; i < len; i++)    temp[(addr & 0x1FF) + i] = buf[i];      //改
  256   1          
  257   1          iap_erase_page(addr);                                                                                       //擦除
  258   1          iap_write_buff(addr & 0xFE00, temp, 512);                                   //写入
  259   1      }
