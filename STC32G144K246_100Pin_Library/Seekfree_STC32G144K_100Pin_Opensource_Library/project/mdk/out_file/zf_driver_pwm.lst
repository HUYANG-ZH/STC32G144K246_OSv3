  173          //                                          PWM_DUTY_MAX在zf_driver_pwm.h文件中 默认为10000
  174          //-------------------------------------------------------------------------------------------------------
             -------------
  175          void pwm_set_freq(pwm_channel_enum pin, uint32 freq, uint32 duty)
  176          {
  177   1          uint32 match_temp = 0;
  178   1          uint32 period_temp = 0;
