  802          /* Baseline implementation: heap-layout complete trees, uint8 thresholds,
  803           * int8 leaves, int32 accumulator. One sample = RAPT_K x RAPT_DEPTH compares. */
  804          uint8 roundabout_priority_tree_predict(uint16 CH1, uint16 CH2, uint16 CH3,
  805                                                 uint16 CH4, uint16 TOF)
  806          {
  807   1          uint8 x[10];
  808   1          int32 acc = 0;
  809   1          uint8 lv;
  810   1          int t, idx;
  811   1          {
  812   2              uint8 c1 = CH1 > 255u ? 255u : (uint8)CH1;
  813   2              uint8 c2 = CH2 > 255u ? 255u : (uint8)CH2;
  814   2              uint8 c3 = CH3 > 255u ? 255u : (uint8)CH3;
  815   2              uint8 c4 = CH4 > 255u ? 255u : (uint8)CH4;
  816   2              uint32 q = (uint32)TOF / 32u, r = (uint32)TOF % 32u;
  817   2              uint8 tf;
  818   2              int v;
  819   2              if (r > 16u) q += 1u;
  820   2              else if (r == 16u) q += (q & 1u);          /* round half to even, matches training */
  821   2              tf = q > 255u ? 255u : (uint8)q;
  822   2              x[0] = c1; x[1] = c2; x[2] = c3; x[3] = c4; x[4] = tf;
  823   2              v = ((int)c4 - (int)c1 + 168) / 2;  x[5] = (uint8)(v > 255 ? 255 : v);
  824   2              v = ((int)c2 - (int)c3 + 168) / 2;  x[6] = (uint8)(v > 255 ? 255 : v);
  825   2              v = (int)c2 + (int)c3;              x[7] = (uint8)(v > 255 ? 255 : v);
  826   2              v = ((int)c1 + (int)c4) / 2;        x[8] = (uint8)(v > 255 ? 255 : v);
  827   2              v = c1 > c4 ? (int)c1 - (int)c4 : (int)c4 - (int)c1;
  828   2                                                  x[9] = (uint8)(v > 255 ? 255 : v);
  829   2          }
  830   1          for (t = 0; t < RAPT_K; ++t) {
  831   2              idx = 0;
  832   2              for (lv = 0; lv < RAPT_DEPTH; ++lv)
  833   2                  idx = idx * 2 + 1 + (x[rapt_feat[t][idx]] > rapt_thr[t][idx]);
  834   2              acc += rapt_leaf[t][idx - RAPT_NODES];
  835   2          }
  836   1          return (acc >= RAPT_TAU) ? (uint8)1 : (uint8)0;
  837   1      }
