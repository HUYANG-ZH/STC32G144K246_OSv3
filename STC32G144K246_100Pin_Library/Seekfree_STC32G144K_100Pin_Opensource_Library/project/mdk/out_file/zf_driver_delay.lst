   59          void system_delay(uint32 period)
   60          {
   61   1          uint8 freq_div;                
   62   1          uint16 period_temp;               
   63   1          uint16 temp;
   64   1      
   65   1          T11CR = 0;
   66   1          if(period > (255 * 65535))
   67   1          {
   68   2              // 设置定时器为12T模式防止溢出
   69   2              period = (period + 5) / 12;  // 四舍五入，降低整数除法误�?
   70   2              T11CR &= ~0x10;
   71   2          }
   72   1          else
   73   1          {
   74   2              // 设置�?T模式
   75   2              T11CR |= 0x10;
   76   2          }
   77   1          
   78   1          freq_div = ((period) >> 16);                    // 计算预分�?
   79   1          period_temp = ((period) / (freq_div + 1));      // 计算自动重装载�?
   80   1          temp = (uint16)65535 - period_temp;
   81   1      
   82   1          T11PS = freq_div;                               // 设置分频�?
   83   1          T11L = temp;
   84   1          T11H = temp >> 8;
   85   1          T11CR |= 0x80;                                      // 启动定时�?
   86   1          
   87   1          while(!(T11CR & 0x01));                         // 等待硬件定时器溢�?
   88   1      
   89   1      }


