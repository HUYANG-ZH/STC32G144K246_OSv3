  578          void ips200_show_gray_image (uint16 x, uint16 y, const uint8 *image, uint16 width, uint16 height, uint16 
             -dis_width, uint16 dis_height, uint8 threshold)
  579          {
  580   1          uint32 i = 0, j = 0;
  581   1          uint16 color ,temp ;
  582   1          uint16 data_buffer[IPS_LEN];
  583   1          const uint8 *image_temp;
  584   1      
