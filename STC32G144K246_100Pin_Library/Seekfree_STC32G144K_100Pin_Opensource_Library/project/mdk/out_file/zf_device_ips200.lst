  603   4                      color = (0x001f & ((temp) >> 3)) << 11;
  604   4                      color = color | (((0x003f) & ((temp) >> 2)) << 5);
  605   4                      color = color | (0x001f & ((temp) >> 3));
  606   4                      data_buffer[i] = (color);
  607   4                  }
  608   3                  else if(temp < threshold)
  609   3                  {
  610   4                      data_buffer[i] = (RGB565_BLACK);
  611   4                  }
  612   3                  else
  613   3                  {
  614   4                      data_buffer[i] = (RGB565_WHITE);
  615   4                  }
  616   3              }
  617   2              ips200_write_16bit_data_array(data_buffer, dis_width);
  618   2          }
  619   1      
  620   1          IPS200_CS(1);
  621   1      
  622   1      }
