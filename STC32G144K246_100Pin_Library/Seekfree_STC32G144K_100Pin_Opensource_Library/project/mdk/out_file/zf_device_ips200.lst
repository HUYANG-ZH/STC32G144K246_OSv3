  526          void ips200_show_chinese (uint16 x, uint16 y, uint8 siz, const uint8 *p, uint8 number, uint16 color)
  527          {
  528   1        int i, j, k; 
  529   1          uint8 temp, temp1, temp2;
  530   1          const uint8 *p_data;
  531   1        
  532   1          zf_assert(x < ips200_x_max);
  533   1          zf_assert(y < ips200_y_max);
  534   1      
  535   1          temp2 = siz/8;
  536   1          
  537   1          ips200_set_region(x,y,number*siz-1+x,y+siz-1);
  538   1          
  539   1          for(i=0;i<siz;i++)
  540   1          {
  541   2              temp1 = number;
  542   2              p_data = p+i*temp2;
  543   2              while(temp1--)
  544   2              {
  545   3                  for(k=0;k<temp2;k++)
  546   3                  {
  547   4                      for(j=8;j>0;j--)
  548   4                      {
  549   5                          temp = (*p_data>>(j-1)) & 0x01;
  550   5                          if(temp)    ips200_write_16bit_data(color);
  551   5                          else        ips200_write_16bit_data(ips200_bgcolor);
  552   5                      }
  553   4                      p_data++;
  554   4                  }
  555   3                  p_data = p_data - temp2 + temp2*siz;
  556   3              }   
  557   2          }
  558   1      }
