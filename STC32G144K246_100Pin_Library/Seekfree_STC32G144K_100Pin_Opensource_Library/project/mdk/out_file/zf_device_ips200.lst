  427          // 函数简介       液晶显示浮点数(去除整数部分无效的0)
  428          // 参数说明       x               坐标x方向的起点 参数范围 [0, ips200_x_max-1]
  429          // 参数说明       y               坐标y方向的起点 参数范围 [0, ips200_y_max-1]
  430          // 参数说明       dat             需要显示的变量，数据类型float或double
  431          // 参数说明       num             整数位显示长度   最高10位
  432          // 参数说明       pointnum        小数位显示长度   最高6位
  433          // 返回参数       void
  434          // 使用示例                ips200_showfloat(0,0,x,2,3);                    // 显示浮点数   整�
             -�显示2位   小数显示三位
  435          // @note                        特别注意当发现小数部分显示的值与你写入的值不一样�
             -��时候，
  436          //                              可能是由于浮点数精度丢失问题导致的，这并不是显示�
             -��数的问题，
  437          //                              有关问题的详情，请自行百度学习   浮点数精度丢失问�
             -��。
  438          //                              负数会显示一个 ‘-’号   正数显示一个空格
  439          //-------------------------------------------------------------------------------------------------------
             -------------
  440          void ips200_show_float(uint16 x,uint16 y,double dat,uint8 num,uint8 pointnum)
  441          {
  442   1          uint8   length;
  443   1          int8    buff[34];
  444   1          int8    start,end,point;
  445   1        
  446   1          zf_assert(x < ips200_x_max);
  447   1          zf_assert(y < ips200_y_max);
  448   1      
  449   1          if(6<pointnum)  pointnum = 6;
  450   1          if(10<num)      num = 10;
  451   1              
  452   1          if(0>dat)   length = zf_sprintf( &buff[0],(const int8 *)"%f",dat);        // 负数
  453   1          else
  454   1          {
  455   2              length = zf_sprintf( &buff[1],(const int8 *)"%f",dat);
  456   2              length++;
  457   2          }
  458   1          point = length - 7;                                                         // 计算小数点位置
  459   1          start = point - num - 1;                                                    // 计算起始位
  460   1          end = point + pointnum + 1;                                                 // 计算结束位
  461   1          while(0>start)                                                              // 整数位不够  末�
             -�应该填充空格
  462   1          {
  463   2              buff[end] = ' ';
  464   2              end++;
  465   2              start++;
  466   2          }
  467   1          
  468   1          if(0>dat)   buff[start] = '-';
