  367   2              uint8 c2 = CH2 > 255u ? 255u : (uint8)CH2;
  368   2              uint8 c3 = CH3 > 255u ? 255u : (uint8)CH3;
  369   2              uint8 c4 = CH4 > 255u ? 255u : (uint8)CH4;
  370   2              uint32 q = (uint32)TOF / 32u, r = (uint32)TOF % 32u;
  371   2              uint8 tf;
  372   2              int v;
  373   2              if (r > 16u) q += 1u;
  374   2              else if (r == 16u) q += (q & 1u);          /* round half to even, matches training */
  375   2              tf = q > 255u ? 255u : (uint8)q;
  376   2              x[0] = c1; x[1] = c2; x[2] = c3; x[3] = c4; x[4] = tf;
  377   2              v = ((int)c4 - (int)c1 + 268) / 2;  x[5] = (uint8)(v > 255 ? 255 : v);
  378   2              v = ((int)c2 - (int)c3 + 148) / 2;  x[6] = (uint8)(v > 255 ? 255 : v);
  379   2              v = (int)c2 + (int)c3;              x[7] = (uint8)(v > 255 ? 255 : v);
  380   2              v = ((int)c1 + (int)c4) / 2;        x[8] = (uint8)(v > 255 ? 255 : v);
  381   2              v = c1 > c4 ? (int)c1 - (int)c4 : (int)c4 - (int)c1;
  382   2                                                  x[9] = (uint8)(v > 255 ? 255 : v);
