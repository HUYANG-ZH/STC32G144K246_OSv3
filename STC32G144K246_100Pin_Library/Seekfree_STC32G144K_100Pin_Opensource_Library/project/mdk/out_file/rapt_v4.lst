  356          /* Baseline implementation: heap-layout complete trees, uint8 thresholds,
  357           * int8 leaves, int32 accumulator. One sample = RAPT_K x RAPT_DEPTH compares. */
  358          uint8 roundabout_priority_tree_predict(uint16 CH1, uint16 CH2, uint16 CH3,
  359                                                 uint16 CH4, uint16 TOF)
  360          {
