   56   1          now = service_timetick_what();
   57   1          if(0U != service_batterycheck_get_raw_snapshot(&rawdata, &sequence))
   58   1          {
   59   2              if((0U == battery_guard_sample_seen) || (sequence != battery_guard_last_sequence))
   60   2              {
   61   3                  battery_guard_last_sequence = sequence;
   62   3                  battery_guard_last_fresh_tick = now;
   63   3                  battery_guard_sample_seen = 1U;
   64   3                  /* 使用发布链路的滤波后电压做欠压判断;
   65   3                     滤波未就绪(主循环尚未发布首帧, 值仍为初值 0.0)时跳过,
   66   3                     避免开机阻塞期内误判欠压触发联锁 */
   67   3                  voltage = service_batterycheck_get_filtered_voltage();
   68   3                  if((0U != service_batterycheck_filter_ready()) &&
   69   3                          (voltage < APP_BATTERY_GUARD_LOW_VOLTAGE))
   70   3                  {
   71   4                      app_battery_guard_trip(voltage, APP_BATTERY_GUARD_REASON_LOW_VOLTAGE);
   72   4                  }
   73   3                  return;
   74   3              }
   75   2          }
   76   1      
   77   1          if((0U == battery_guard_sample_seen) &&
   78   1                  ((uint32)(now - battery_guard_start_tick) >= APP_BATTERY_GUARD_STARTUP_GRACE_TICK))
   79   1          {
   80   2              app_battery_guard_trip(0.0f, APP_BATTERY_GUARD_REASON_STALE_SAMPLE);
   81   2          }
   82   1          else if((0U != battery_guard_sample_seen) &&
   83   1                  ((uint32)(now - battery_guard_last_fresh_tick) >= APP_BATTERY_GUARD_MAX_SAMPLE_AGE_TICK))
   84   1          {
   85   2              app_battery_guard_trip(0.0f, APP_BATTERY_GUARD_REASON_STALE_SAMPLE);
   86   2          }
   87   1      }
