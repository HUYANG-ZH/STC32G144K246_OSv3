   29          static void app_battery_guard_trip(float voltage, uint8 reason)
   30          {
   31   1          if(0U != battery_guard_triggered)
   32   1          {
   33   2              return;
   34   2          }
   35   1      
   36   1          battery_guard_triggered = 1U;
   37   1          battery_guard_trip_voltage = voltage;
   38   1          battery_guard_reason = reason;
   39   1          battery_guard_report_pending = 1U;
   40   1          /* 仅报警, 不对车辆做任何动作(不下发联锁/不停机/不关负压) */
   41   1      }
